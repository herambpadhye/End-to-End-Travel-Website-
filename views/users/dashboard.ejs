    ];

    function resetServicesSelection() {

        if (servicesSlideshowTimer) {
            clearInterval(servicesSlideshowTimer);
            servicesSlideshowTimer = null;
        }

        selectedListingTitle.textContent = "";
        selectedListingTitle.style.display = "none";
        selectedServicesListingLocation = "";
        servicesListingPreview.style.display = "none";
        servicesListingImage.removeAttribute("src");
        servicesListingImage.style.display = "block";
        servicesListingNoImages.style.display = "none";
        fixItFirstHeading.style.display = "none";
        fixItFirstGrid.style.display = "none";
        extraCareSection.style.display = "none";
        extraCareGrid.replaceChildren();
    }

    function getExtraCareCategories(listing) {

        const listingText = [
            listing.location,
            listing.extraCareCategory,
            listing.title
        ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

        return extraCareCatalog.filter(category =>
            category.keywords.some(keyword =>
                listingText.includes(keyword)
            )
        );
    }

    function displayExtraCare(listing) {

        const categories =
            getExtraCareCategories(listing);

        extraCareGrid.replaceChildren();

        categories.forEach(category => {

            category.services.forEach(service => {

                const card =
                    document.createElement("article");

                card.className = "service-card";

                const icon =
                    document.createElement("i");

                icon.className = "fa-solid fa-star";
                icon.setAttribute("aria-hidden", "true");

                const title =
                    document.createElement("h4");

                title.textContent = service;
                card.append(icon, title);
                extraCareGrid.appendChild(card);
            });
        });

        extraCareSection.style.display =
            categories.length
                ? "block"
                : "none";
    }

    function startServicesSlideshow(images) {

        if (servicesSlideshowTimer) {
            clearInterval(servicesSlideshowTimer);
            servicesSlideshowTimer = null;
        }

        if (!images.length) {
            servicesListingPreview.style.display = "block";
            servicesListingImage.removeAttribute("src");
            servicesListingImage.style.display = "none";
            servicesListingNoImages.style.display = "flex";
            return;
        }

        let imageIndex = 0;

        servicesListingImage.src = images[imageIndex];
        servicesListingImage.style.display = "block";
        servicesListingNoImages.style.display = "none";
        servicesListingPreview.style.display = "block";

        if (images.length > 1) {
            servicesSlideshowTimer =
                setInterval(() => {
                    imageIndex =
                        (imageIndex + 1) % images.length;

                    servicesListingImage.src =
                        images[imageIndex];
                }, 3000);
        }
    }

    function openServiceGoogleMapsSearch(event) {

        const card =
            event.target.closest(".service-card");

        if (!card) {
            return;
        }

        const serviceName =
            card.querySelector("h4")?.textContent.trim();

        const listingLocation =
            selectedServicesListingLocation.trim();

        if (!serviceName || !listingLocation) {
            return;
        }

        const searchQuery =
            `${serviceName} near ${listingLocation}`;

        const googleMapsUrl =
            "https://www.google.com/maps/search/?api=1&query=" +
            encodeURIComponent(searchQuery);

        window.open(
            googleMapsUrl,
            "_blank",
            "noopener,noreferrer"
        );
    }

    fixItFirstGrid.addEventListener(
        "click",
        openServiceGoogleMapsSearch
    );

    extraCareGrid.addEventListener(
        "click",
        openServiceGoogleMapsSearch
    );

    servicesListing.addEventListener("change", async () => {

        const listingId =
            servicesListing.value;

        const selectionRequest =
            ++servicesSelectionRequest;

        resetServicesSelection();

        if (!listingId) {
            return;
        }

        try {

            const response =
                await fetch(
                    `/users/dashboard?listingId=${encodeURIComponent(listingId)}`
                );

            const listing =
                await response.json();

            if (
                selectionRequest !==
                servicesSelectionRequest
            ) {
                return;
            }

            if (!response.ok || !listing.success) {
                throw new Error(
                    listing.message ||
                    "Unable to load listing services."
                );
            }

            selectedListingTitle.textContent =
                listing.title ||
                "Selected listing";

            selectedServicesListingLocation =
                typeof listing.location === "string"
                    ? listing.location
                    : "";

            selectedListingTitle.style.display =
                "block";

            const images =
                Array.isArray(listing.images)
                    ? listing.images.filter(
                        image =>
                            typeof image === "string" &&
                            image.trim()
                    )
                    : [];

            startServicesSlideshow(images);

            fixItFirstHeading.style.display = "block";
            fixItFirstGrid.style.display = "grid";
            displayExtraCare(listing);

        } catch (error) {

            console.error(
                "Unable to load selected listing services:",
                error
            );
        }
    });
</script>
