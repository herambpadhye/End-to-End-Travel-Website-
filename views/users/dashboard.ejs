        {
            name: "RAINY, JUNGLE & FOREST REGION",
            keywords: [
                "rainy",
                "jungle",
                "forest",
                "rainforest",
                "monsoon",
                "kerala",
                "assam",
                "meghalaya"
            ],
            services: [
                "Tree Care & Timber Treatment",
                "Mold & Damp Treatment",
                "Pest Control & Fogging",
                "Roof Waterproofing & Drainage"
            ]
        },
        {
            name: "BEACHFRONT & COASTAL REGION",
            keywords: [
                "beach",
                "coast",
                "coastal",
                "seaside",
                "shoreline",
                "goa",
                "pondicherry",
                "puducherry",
                "andaman"
            ],
            services: [
                "Anti-Rust & Coating Treatment",
                "Sand & Deck Cleaning",
