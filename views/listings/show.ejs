<% layout("/layouts/boilerplate") %>

<div class="show-container">

    <h2 class="show-heading">Listing Details</h2>

    <% if (!listing) { %>

        <div class="error-box">
            Listing not found
        </div>

  <% } else { %>

    <%
        const selectedBooking =
            typeof bookingSelection !== "undefined" ? bookingSelection : {};
        const stickyReviewCount =
            Array.isArray(reviews) ? reviews.length : 0;
        const stickyAverageRating =
            stickyReviewCount > 0
                ? reviews.reduce(
                    (total, review) => total + Number(review.rating || 0),
                    0
                ) / stickyReviewCount
                : null;
        const hasValidListingCoordinates =
            listing.coordinates &&
            String(listing.coordinates.lat).trim() !== "" &&
            listing.coordinates.lat !== null &&
            listing.coordinates.lat !== undefined &&
            String(listing.coordinates.lng).trim() !== "" &&
            listing.coordinates.lng !== null &&
            listing.coordinates.lng !== undefined &&
            Number.isFinite(Number(listing.coordinates.lat)) &&
            Number.isFinite(Number(listing.coordinates.lng)) &&
            Number(listing.coordinates.lat) >= -90 &&
            Number(listing.coordinates.lat) <= 90 &&
            Number(listing.coordinates.lng) >= -180 &&
            Number(listing.coordinates.lng) <= 180;
    %>

    <style>
        .listing-booking-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 320px;
            align-items: start;
            gap: 24px;
        }

        .listing-summary {
            min-width: 0;
        }

        .listing-booking-card {
            min-width: 0;
            padding: 22px;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .booking-price-summary {
            margin-bottom: 18px;
            color: #222;
            font-size: 1.2rem;
            font-weight: 700;
        }

        .listing-sticky-bar {
            position: fixed;
            z-index: 999;
            top: 60px;
            right: 0;
            left: 0;
            padding: 10px 5%;
            border-bottom: 1px solid #e5e7eb;
            background: #fff;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
        }

        .listing-sticky-bar[hidden] {
            display: none;
        }

        .listing-sticky-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            max-width: 1440px;
            margin: 0 auto;
        }

        .listing-sticky-nav {
            display: flex;
            align-items: center;
            gap: 18px;
            min-width: 0;
        }

        .listing-sticky-nav a {
            flex: 0 0 auto;
            color: #333;
            font-size: 0.9rem;
            text-decoration: none;
        }

        .listing-sticky-nav a:hover {
            color: #ff385c;
        }

        .listing-sticky-details {
            display: flex;
            align-items: center;
            gap: 16px;
            color: #222;
            white-space: nowrap;
        }

        .listing-sticky-price {
            font-weight: 700;
        }

        .listing-sticky-nightly,
        .listing-sticky-rating {
            color: #555;
            font-size: 0.85rem;
        }

        .listing-sticky-submit {
            flex: 0 0 auto;
            padding: 11px 18px;
            border: 0;
            border-radius: 9px;
            background: #ff385c;
            color: #fff;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .listing-sticky-submit:hover {
            background: #e31c5f;
            transform: translateY(-1px);
        }

        #photos,
        #amenities,
        #location,
        #reviews {
            scroll-margin-top: 140px;
        }

        .booking-date-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            overflow: hidden;
            border: 1px solid #b8bec8;
            border-radius: 10px;
        }

        .booking-date-field {
            min-width: 0;
            padding: 10px;
        }

        .booking-date-field + .booking-date-field {
            border-left: 1px solid #b8bec8;
        }

        .booking-date-field label,
        .booking-guests-label {
            display: block;
            margin-bottom: 5px;
            color: #222;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.06em;
        }

        .booking-date-field input {
            width: 100%;
            min-width: 0;
            padding: 3px 0;
            border: 0;
            background: transparent;
            color: #333;
            font: inherit;
            font-size: 0.85rem;
        }

        .booking-date-field input:focus {
            outline: none;
        }

        .booking-calendar {
            margin-top: 12px;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            background: #fff;
        }

        .booking-calendar[hidden] {
            display: none;
        }

        .booking-calendar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .booking-calendar-header h3 {
            margin: 0;
            font-size: 0.95rem;
        }

        .booking-calendar-header button,
        .booking-calendar-day {
            min-width: 36px;
            min-height: 36px;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: #222;
            font: inherit;
        }

        .booking-calendar-header button {
            cursor: pointer;
        }

        .booking-calendar-header button:focus-visible,
        .booking-calendar-day:focus-visible {
            outline: 2px solid #536175;
            outline-offset: 2px;
        }

        .booking-calendar-weekdays,
        .booking-calendar-days {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 3px;
            text-align: center;
        }

        .booking-calendar-weekdays {
            margin-bottom: 4px;
            color: #555;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .booking-calendar-weekdays span {
            padding: 5px 0;
        }

        .booking-calendar-day {
            width: 100%;
            cursor: pointer;
        }

        .booking-calendar-day:hover:not(:disabled) {
            background: #f3f4f6;
        }

        .booking-calendar-day.is-selected {
            background: #ff385c;
            color: #fff;
        }

        .booking-calendar-day:disabled,
        .booking-calendar-day.is-unavailable {
            background: #f3f4f6;
            color: #a1a1aa;
            cursor: not-allowed;
            text-decoration: line-through;
        }

        .booking-calendar-day.is-outside-month {
            visibility: hidden;
        }

        .booking-date-row:focus-within,
        .booking-guests-trigger:focus-visible {
            outline: 2px solid #536175;
            outline-offset: 2px;
        }

        .booking-guests {
            position: relative;
            margin-top: 12px;
        }

        .booking-guests-trigger {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #b8bec8;
            border-radius: 10px;
            background: #fff;
            color: #333;
            font: inherit;
            text-align: left;
            cursor: pointer;
        }

        .booking-guests-trigger:hover {
            border-color: #536175;
        }

        .booking-guests-summary {
            display: block;
            font-size: 0.9rem;
        }

        .booking-guest-popover {
            margin-top: 8px;
            padding: 8px 14px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        }

        .booking-guest-popover[hidden] {
            display: none;
        }

        .booking-guest-counter {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 0;
        }

        .booking-guest-counter + .booking-guest-counter {
            border-top: 1px solid #eee;
        }

        .booking-guest-type {
            color: #222;
            font-weight: 600;
        }

        .booking-guest-control {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .booking-guest-control button {
            display: inline-flex;
            width: 32px;
            height: 32px;
            align-items: center;
            justify-content: center;
            border: 1px solid #87909d;
            border-radius: 50%;
            background: #fff;
            color: #333;
            font: inherit;
            font-size: 1.1rem;
            line-height: 1;
            cursor: pointer;
        }

        .booking-guest-control button:disabled {
            border-color: #d5d8de;
            color: #a5aab2;
            cursor: not-allowed;
        }

        .booking-guest-count {
            min-width: 18px;
            color: #222;
            text-align: center;
        }

        .booking-submit {
            width: 100%;
            margin-top: 16px;
            padding: 14px 18px;
            border: 0;
            border-radius: 10px;
            background: #ff385c;
            color: #fff;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .booking-submit:hover {
            background: #e31c5f;
            transform: translateY(-1px);
        }

        .nearby-listings-section {
            margin-top: 28px;
        }

        .nearby-listings-heading {
            margin: 0 0 16px;
            color: #222;
            font-size: 1.35rem;
            font-weight: 600;
        }

        .nearby-listings-carousel {
            display: grid;
            grid-template-columns: 40px minmax(0, 1fr) 40px;
            align-items: center;
            gap: 10px;
        }

        .nearby-listings-arrow {
            display: inline-flex;
            width: 40px;
            height: 40px;
            align-items: center;
            justify-content: center;
            border: 1px solid #e5e7eb;
            border-radius: 50%;
            background: #fff;
            color: #222;
            cursor: pointer;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .nearby-listings-arrow:hover:not(:disabled) {
            border-color: #ff385c;
            background: #fff5f6;
        }

        .nearby-listings-arrow:disabled {
            color: #a5aab2;
            cursor: not-allowed;
            opacity: 0.5;
        }

        .nearby-listings-row {
            display: flex;
            min-width: 0;
            gap: 18px;
            overflow-x: auto;
            padding: 2px 2px 14px;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .nearby-listings-row::-webkit-scrollbar {
            display: none;
        }

        .nearby-listing-card {
            flex: 0 0 220px;
            overflow: hidden;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            background: #fff;
            color: inherit;
            text-decoration: none;
            scroll-snap-align: start;
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }

        .nearby-listing-card:hover {
            color: inherit;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
            text-decoration: none;
            transform: translateY(-2px);
        }

        .nearby-listing-image {
            display: block;
            width: 100%;
            height: 150px;
            object-fit: cover;
            background: #f3f4f6;
        }

        .nearby-listing-details {
            padding: 12px;
        }

        .nearby-listing-title {
            display: -webkit-box;
            overflow: hidden;
            min-height: 2.6em;
            margin: 0 0 7px;
            color: #222;
            font-size: 0.95rem;
            font-weight: 600;
            line-height: 1.3;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .nearby-listing-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px 10px;
            color: #555;
            font-size: 0.82rem;
        }

        .nearby-listing-price {
            color: #222;
            font-weight: 600;
        }

        .nearby-listing-rating {
            color: #333;
        }

        .nearby-listing-rating .fa-star {
            color: #ff385c;
        }

        @media (max-width: 576px) {
            .nearby-listings-carousel {
                grid-template-columns: 34px minmax(0, 1fr) 34px;
                gap: 6px;
            }

            .nearby-listings-arrow {
                width: 34px;
                height: 34px;
            }

            .nearby-listings-row {
                gap: 12px;
            }

            .nearby-listing-card {
                flex-basis: 190px;
            }
        }

        @media (max-width: 1100px) {
            .listing-booking-layout {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @media (max-width: 576px) {
            .show-container {
                width: 94%;
            }

            .listing-booking-card {
                padding: 16px;
            }

            .listing-sticky-bar {
                padding: 10px 3%;
            }

            .listing-sticky-inner {
                flex-wrap: wrap;
                gap: 10px;
            }

            .listing-sticky-nav {
                order: 3;
                width: 100%;
                overflow-x: auto;
                gap: 16px;
                padding: 2px 0;
            }

            .listing-sticky-details {
                flex-wrap: wrap;
                gap: 4px 10px;
                white-space: normal;
            }

            .listing-sticky-submit {
                padding: 10px 14px;
            }

            .booking-date-field {
                padding: 9px 7px;
            }
        }
    </style>

    <nav
        class="listing-sticky-bar"
        id="listing-sticky-bar"
        aria-label="Listing summary"
        aria-hidden="true"
        hidden
    >
        <div class="listing-sticky-inner">
            <div class="listing-sticky-nav">
                <a href="#photos">Photos</a>
                <% if (Array.isArray(listing.amenities) && listing.amenities.length > 0) { %>
                    <a href="#amenities">Amenities</a>
                <% } %>
                <a href="#reviews">Reviews</a>
                <a href="#location">Location</a>
            </div>
            <div class="listing-sticky-details">
                <span
                    class="listing-sticky-price"
                    id="sticky-price-summary"
                    data-nightly-price="<%= listing.price %>"
                >
                    <span class="listing-price-total">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                    <span class="listing-price-night-label">for 1 night</span>
                </span>
                <span class="listing-sticky-nightly">
                    &#8377;<%= listing.price.toLocaleString("en-IN") %> per night
                </span>
                <% if (stickyAverageRating !== null) { %>
                    <span class="listing-sticky-rating">
                        &#9733; <%= stickyAverageRating.toFixed(1) %> · <%= stickyReviewCount %>
                        <%= stickyReviewCount === 1 ? "review" : "reviews" %>
                    </span>
                <% } %>
            </div>
            <button
                class="listing-sticky-submit"
                id="listing-sticky-book-now"
                type="button"
            >Check Availability</button>
        </div>
    </nav>

    <div class="show-card">

        <%
            let listingImages = [];

            if (listing.images && listing.images.length > 0) {

                listingImages = listing.images;

            } else if (
                listing.image &&
                listing.image.url
            ) {

                listingImages = [
                    listing.image.url
                ];

            }
        %>

        <div class="listing-image-slider" id="photos">

            <% listingImages.forEach(function(image, index) { %>

                <img
                    src="<%= image %>"
                    class="listing-slide <%= index === 0 ? 'active-slide' : '' %>"
                    alt="listing image <%= index + 1 %>"
                >

            <% }); %>


            <% if (listingImages.length > 1) { %>

                <button
                    type="button"
                    class="listing-slide-btn listing-prev"
                    onclick="moveListingSlide(-1)"
                >
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <button
                    type="button"
                    class="listing-slide-btn listing-next"
                    onclick="moveListingSlide(1)"
                >
                    <i class="fa-solid fa-chevron-right"></i>
                </button>


                <div class="listing-slide-dots">

                    <% listingImages.forEach(function(image, index) { %>

                        <span
                            class="listing-dot <%= index === 0 ? 'active-dot' : '' %>"
                            onclick="goToListingSlide(<%= index %>)"
                        ></span>

                    <% }); %>

                </div>

            <% } %>

        </div>

        <div class="show-details">

            <div class="listing-booking-layout">
                <section class="listing-summary" aria-label="Listing summary">
                    <h3 class="show-title">
                        <%= listing.title %>
                    </h3>


                    <p class="show-description">
                        <%= listing.description %>
                    </p>

                    <p class="show-location">
                        <%= listing.location %>
                    </p>

                    <% if (
                        listing.propertyName ||
                        listing.landmark ||
                        listing.locality ||
                        listing.city ||
                        listing.state ||
                        listing.pincode
                    ) { %>
                        <div class="show-property-location">
                            <% if (listing.propertyName) { %>
                                <p><strong>Property:</strong> <%= listing.propertyName %></p>
                            <% } %>
                            <% if (listing.landmark) { %>
                                <p><strong>Nearby landmark:</strong> <%= listing.landmark %></p>
                            <% } %>
                            <% if (listing.locality) { %>
                                <p><strong>Locality / area:</strong> <%= listing.locality %></p>
                            <% } %>
                            <% if (listing.city) { %>
                                <p><strong>City:</strong> <%= listing.city %></p>
                            <% } %>
                            <% if (listing.state) { %>
                                <p><strong>State:</strong> <%= listing.state %></p>
                            <% } %>
                            <% if (listing.pincode) { %>
                                <p><strong>PIN code:</strong> <%= listing.pincode %></p>
                            <% } %>
                        </div>
                    <% } %>
                </section>

                <aside class="listing-booking-card" aria-label="Book this listing">
                    <form
                        id="listing-booking-form"
                        method="GET"
                        action="/listings/<%= listing._id %>/booking"
                        data-unavailable-date-ranges="<%= JSON.stringify(unavailableDateRanges || []) %>"
                        novalidate
                    >
                        <% if (availabilityError) { %>
                            <p class="error-box" role="alert"><%= availabilityError %></p>
                        <% } %>
                        <p
                            class="booking-price-summary"
                            id="booking-price-summary"
                            data-nightly-price="<%= listing.price %>"
                        >
                            <span class="listing-price-total">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                            <span class="listing-price-night-label">for 1 night</span>
                        </p>
                        <div class="booking-date-row">
                            <div class="booking-date-field">
                                <label for="booking-check-in">CHECK-IN</label>
                                <input
                                    id="booking-check-in"
                                    name="checkIn"
                                    type="text"
                                    value="<%= selectedBooking.checkIn || '' %>"
                                    placeholder="Add date"
                                    autocomplete="off"
                                    aria-haspopup="dialog"
                                    aria-expanded="false"
                                    aria-controls="booking-calendar-check-in"
                                    readonly
                                    required
                                >
                            </div>
                            <div class="booking-date-field">
                                <label for="booking-check-out">CHECKOUT</label>
                                <input
                                    id="booking-check-out"
                                    name="checkOut"
                                    type="text"
                                    value="<%= selectedBooking.checkOut || '' %>"
                                    placeholder="Add date"
                                    autocomplete="off"
                                    aria-haspopup="dialog"
                                    aria-expanded="false"
                                    aria-controls="booking-calendar-check-out"
                                    readonly
                                    required
                                >
                            </div>
                        </div>
                        <% ["check-in", "check-out"].forEach(function(calendarType) { %>
                            <div
                                class="booking-calendar"
                                id="booking-calendar-<%= calendarType %>"
                                role="dialog"
                                aria-label="Choose <%= calendarType === 'check-in' ? 'check-in' : 'checkout' %> date"
                                data-calendar-for="<%= calendarType === 'check-in' ? 'checkIn' : 'checkOut' %>"
                                hidden
                            >
                                <div class="booking-calendar-header">
                                    <button type="button" data-calendar-month-change="-1" aria-label="Previous month">&#8249;</button>
                                    <h3 data-calendar-month-label></h3>
                                    <button type="button" data-calendar-month-change="1" aria-label="Next month">&#8250;</button>
                                </div>
                                <div class="booking-calendar-weekdays" aria-hidden="true">
                                    <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                                </div>
                                <div class="booking-calendar-days" data-calendar-days></div>
                            </div>
                        <% }); %>

                        <p
                            id="booking-availability-message"
                            role="status"
                            aria-live="polite"
                            hidden
                        ></p>

                        <div class="booking-guests">
                            <span class="booking-guests-label">GUESTS</span>
                            <button
                                id="booking-guests-trigger"
                                class="booking-guests-trigger"
                                type="button"
                                aria-expanded="false"
                                aria-controls="booking-guest-popover"
                            >
                                <span id="booking-guests-summary" class="booking-guests-summary">
                                    <%= (Number(selectedBooking.adults) || 4) + (Number(selectedBooking.children) || 0) %> guests · <%= Number(selectedBooking.pets) || 0 %> pets
                                </span>
                            </button>

                            <div
                                id="booking-guest-popover"
                                class="booking-guest-popover"
                                role="group"
                                aria-label="Choose guests"
                                hidden
                            >
                                <div class="booking-guest-counter" data-guest-type="adults" data-minimum="1">
                                    <span class="booking-guest-type">Adults</span>
                                    <span class="booking-guest-control">
                                        <button type="button" data-guest-change="-1" aria-label="Remove one adult">−</button>
                                        <span class="booking-guest-count" data-guest-count><%= Number(selectedBooking.adults) || 4 %></span>
                                        <button type="button" data-guest-change="1" aria-label="Add one adult">+</button>
                                    </span>
                                </div>
                                <div class="booking-guest-counter" data-guest-type="children" data-minimum="0">
                                    <span class="booking-guest-type">Children</span>
                                    <span class="booking-guest-control">
                                        <button type="button" data-guest-change="-1" aria-label="Remove one child">−</button>
                                        <span class="booking-guest-count" data-guest-count><%= Number(selectedBooking.children) || 0 %></span>
                                        <button type="button" data-guest-change="1" aria-label="Add one child">+</button>
                                    </span>
                                </div>
                                <div class="booking-guest-counter" data-guest-type="pets" data-minimum="0">
                                    <span class="booking-guest-type">Pets</span>
                                    <span class="booking-guest-control">
                                        <button type="button" data-guest-change="-1" aria-label="Remove one pet">−</button>
                                        <span class="booking-guest-count" data-guest-count><%= Number(selectedBooking.pets) || 0 %></span>
                                        <button type="button" data-guest-change="1" aria-label="Add one pet">+</button>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="adults" value="<%= Number(selectedBooking.adults) || 4 %>" data-guest-value="adults">
                        <input type="hidden" name="children" value="<%= Number(selectedBooking.children) || 0 %>" data-guest-value="children">
                        <input type="hidden" name="pets" value="<%= Number(selectedBooking.pets) || 0 %>" data-guest-value="pets">

