                            Add Review
                        </button>


                    </form>


                <% } else { %>


                    <div class="review-login-message">

                        <p>
                            Please
                            <a href="/users/login">Login</a>
                            or
                            <a href="/users/signup">Sign Up</a>
                            to share your experience.
                        </p>

                    </div>


                <% } %>


                <!-- ================================= -->
                <!-- REVIEW CARDS -->
                <!-- ================================= -->

                <% if (reviews && reviews.length > 0) { %>


                    <div class="reviews-carousel-wrapper">

                        <button
                            type="button"
                            class="review-arrow review-arrow-left"
                            onclick="moveReviews(-1)"
                        >
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>


                        <div
                            class="reviews-carousel"
                            id="reviews-carousel"
                        >

                            <% reviews.forEach(review => { %>


                                <div class="review-card">


                                    <div class="review-card-top">


                                        <div class="review-user">


                                            <% if (
                                                review.user &&
                                                review.user.profilePicture
                                            ) { %>

                                                <img
                                                    src="<%= review.user.profilePicture %>"
                                                    class="review-profile-picture"
                                                    alt="Profile"
                                                >

                                            <% } else { %>

                                                <div class="review-profile-placeholder">

                                                    <i class="fa-solid fa-user"></i>

                                                </div>

                                            <% } %>


                                            <div class="review-user-name">

                                                <%
                                                    let reviewerName =
                                                        review.user
                                                            ? review.user.email.split("@")[0]
                                                            : "User";

                                                    reviewerName =
                                                        reviewerName
                                                            .replace(/[._-]+/g, " ")
                                                            .split(" ")
                                                            .filter(Boolean)
                                                            .map(part =>
                                                                part.charAt(0).toUpperCase() +
                                                                part.slice(1)
                                                            )
                                                            .join(" ");
                                                %>


                                                <%= reviewerName %>

                                            </div>

                                        </div>


                                        <!-- DELETE ONLY OWN REVIEW -->

                                        <% if (
                                            currentUser &&
                                            review.user &&
                                            currentUser._id.toString() ===
                                            review.user._id.toString()
                                        ) { %>


                                            <form
                                                method="POST"
                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            >

                                                <button
                                                    type="submit"
                                                    class="delete-review-btn"
                                                    title="Delete your review"
                                                >

                                                    <i class="fa-solid fa-trash"></i>

                                                </button>

                                            </form>


                                        <% } %>


                                    </div>


                                    <!-- RATING -->

                                    <div class="review-rating">

                                        <span class="review-rating-number">
                                            <%= review.rating %>
                                        </span>

                                        <span class="review-stars">

                                            <% for (let i = 1; i <= 5; i++) { %>

                                                <% if (review.rating >= i) { %>

                                                    <span>★</span>

                                                <% } else if (review.rating >= i - 0.5) { %>

                                                    <span class="half-star">★</span>

                                                <% } else { %>

                                                    <span class="empty-star">★</span>

                                                <% } %>

                                            <% } %>

                                        </span>

                                    </div>


                                    <!-- COMMENT -->

                                    <p class="review-comment">
                                        <%= review.comment %>
                                    </p>


                                </div>


                            <% }) %>

                        </div>


                        <button
                            type="button"
                            class="review-arrow review-arrow-right"
                            onclick="moveReviews(1)"
                        >

                            <i class="fa-solid fa-chevron-right"></i>

                        </button>

                    </div>


                <% } else { %>


                    <p class="no-reviews">
                        No reviews yet. Be the first to share your experience.
                    </p>


                <% } %>


            </div>


            <% if (listing.host) { %>

            <div class="host-info-card">

                <h4 class="host-info-heading">
                    Hosted by
                </h4>


                <div class="host-info-top">

                    <% if (listing.host.profilePicture) { %>

                        <img
                            src="<%= listing.host.profilePicture %>"
                            alt="<%= hostDisplayName %>"
                            class="host-info-picture"
                        >

                    <% } else { %>

                        <div class="host-info-picture-placeholder">

                            <i class="fa-solid fa-user"></i>

                        </div>

                    <% } %>


                    <div class="host-info-identity">

                        <div class="host-info-name">

                            <%= hostDisplayName %>

                        </div>

                        <p class="host-info-since">
                            Since <%= listingPostedDate %>
                        </p>

                    </div>

                </div>


                <p class="host-info-phone">

                    <i class="fa-solid fa-phone"></i>

                    <%= listing.host.hostPhone || "Not added" %>

                </p>


                <p class="host-info-description">

                    <%= listing.host.hostDescription || "No description added yet." %>

                </p>


                <% if (hostWhatsAppLink) { %>

                    <a
                        href="<%= hostWhatsAppLink %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="host-whatsapp-btn"
                    >

                        <i class="fa-brands fa-whatsapp"></i>

                        Contact Host

                    </a>

                <% } %>

            </div>

            <% } %>


            <!-- EXISTING BUTTONS -->

            <div class="show-buttons">

                <% if (
                    typeof currentUser !== "undefined" &&
                    currentUser &&
                    currentUser.isHost
                ) { %>

                <a
                    href="/listings/<%= listing._id %>/edit"
                    class="edit-btn"
                >
                    Edit
                </a>

                <% } %>


                <% if (
                    typeof currentUser !== "undefined" &&
                    currentUser &&
                    currentUser.isHost
                ) { %>

                <form
                    method="POST"
                    action="/listings/<%= listing._id %>?_method=DELETE"
                >

                    <button
                        class="delete-btn"
                    >
                        Delete
                    </button>

                </form>

                <% } %>

            </div>


        </div>

    </div>


    <% } %>

</div>

<script src="/js/listing-booking.js"></script>

<script>
    (() => {
        const bookingForm =
            document.getElementById("listing-booking-form");
        const bookingCard =
            document.querySelector(".listing-booking-card");
        const stickyBar =
            document.getElementById("listing-sticky-bar");
        const stickyBookNow =
            document.getElementById("listing-sticky-book-now");
        const checkInInput =
            document.getElementById("booking-check-in");
        const checkOutInput =
            document.getElementById("booking-check-out");
        const priceSummaries =
            document.querySelectorAll("[data-nightly-price]");

        if (
            !bookingForm ||
            !bookingCard ||
            !stickyBar ||
            !stickyBookNow ||
            !checkInInput ||
            !checkOutInput ||
            !priceSummaries.length
        ) {
            return;
        }

        const nightlyPrice =
            Number(priceSummaries[0].dataset.nightlyPrice);
        const currencyFormatter =
            new Intl.NumberFormat("en-IN", {
                maximumFractionDigits: 0
            });

        function updatePriceSummaries() {
            let nights = 1;

            if (checkInInput.value && checkOutInput.value) {
                const checkInParts =
                    checkInInput.value.split("-").map(Number);
                const checkOutParts =
                    checkOutInput.value.split("-").map(Number);
                const checkInTime =
                    Date.UTC(
                        checkInParts[0],
                        checkInParts[1] - 1,
                        checkInParts[2]
                    );
                const checkOutTime =
                    Date.UTC(
                        checkOutParts[0],
                        checkOutParts[1] - 1,
                        checkOutParts[2]
                    );
                const selectedNights =
                    (checkOutTime - checkInTime) / 86400000;

                if (Number.isInteger(selectedNights) && selectedNights > 0) {
                    nights = selectedNights;
                }
            }

            const totalPrice =
                currencyFormatter.format(nightlyPrice * nights);
            const nightLabel = nights === 1 ? "night" : "nights";

            priceSummaries.forEach((summary) => {
                summary.textContent =
                    `₹${totalPrice} for ${nights} ${nightLabel}`;
            });
        }

        function updateStickyVisibility() {
            const shouldShow =
                bookingCard.getBoundingClientRect().bottom <= 60;

            stickyBar.hidden = !shouldShow;
            stickyBar.setAttribute("aria-hidden", String(!shouldShow));
        }

        checkInInput.addEventListener("change", updatePriceSummaries);
        checkOutInput.addEventListener("change", updatePriceSummaries);
        stickyBookNow.addEventListener("click", function () {
            bookingForm.requestSubmit();
        });
        window.addEventListener("scroll", updateStickyVisibility, {
            passive: true
        });
        window.addEventListener("resize", updateStickyVisibility);

        updatePriceSummaries();
        updateStickyVisibility();
    })();
</script>

<script>
    (() => {
        const amenitiesModal =
            document.getElementById("amenities-modal");
        const showAmenitiesButton =
            document.getElementById("show-all-amenities");
        const closeAmenitiesButton =
            document.getElementById("close-amenities-modal");

        if (!amenitiesModal || !showAmenitiesButton || !closeAmenitiesButton) {
            return;
        }

        let previousBodyOverflow = "";

        function closeAmenitiesModal() {
            amenitiesModal.hidden = true;
            document.body.style.overflow = previousBodyOverflow;
            showAmenitiesButton.focus();
        }

        showAmenitiesButton.addEventListener("click", function () {
            previousBodyOverflow = document.body.style.overflow;
            amenitiesModal.hidden = false;
            document.body.style.overflow = "hidden";
            closeAmenitiesButton.focus();
        });

        closeAmenitiesButton.addEventListener(
            "click",
            closeAmenitiesModal
        );

        amenitiesModal.addEventListener("click", function (event) {
            if (event.target === amenitiesModal) {
                closeAmenitiesModal();
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && !amenitiesModal.hidden) {
                closeAmenitiesModal();
            }
        });
    })();
</script>


