<% layout("/layouts/boilerplate") %>

<div class="show-container">

    <h2 class="show-heading">Listing Details</h2>

    <% if (!listing) { %>

        <div class="error-box">
            Listing not found
        </div>

  <% } else { %>

    <%
        const stickyReviewCount =
            Array.isArray(reviews) ? reviews.length : 0;
        const stickyAverageRating =
            stickyReviewCount > 0
                ? reviews.reduce(
                    (total, review) => total + Number(review.rating || 0),
                    0
                ) / stickyReviewCount
                : null;
    %>

    <style>
        .listing-booking-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 320px;
            align-items: start;
            gap: 24px;
        }

        .listing-summary {
            min-width: 0;
        }

        .listing-booking-card {
            min-width: 0;
            padding: 22px;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .booking-price-summary {
            margin-bottom: 18px;
            color: #222;
            font-size: 1.2rem;
            font-weight: 700;
        }

        .listing-sticky-bar {
            position: fixed;
            z-index: 999;
            top: 60px;
            right: 0;
            left: 0;
            padding: 10px 5%;
            border-bottom: 1px solid #e5e7eb;
            background: #fff;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
        }

        .listing-sticky-bar[hidden] {
            display: none;
        }

        .listing-sticky-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            max-width: 1440px;
            margin: 0 auto;
        }

        .listing-sticky-nav {
            display: flex;
            align-items: center;
            gap: 18px;
            min-width: 0;
        }

        .listing-sticky-nav a {
            flex: 0 0 auto;
            color: #333;
            font-size: 0.9rem;
            text-decoration: none;
        }

        .listing-sticky-nav a:hover {
            color: #ff385c;
        }

        .listing-sticky-details {
            display: flex;
            align-items: center;
            gap: 16px;
            color: #222;
            white-space: nowrap;
        }

        .listing-sticky-price {
            font-weight: 700;
        }

        .listing-sticky-nightly,
        .listing-sticky-rating {
            color: #555;
            font-size: 0.85rem;
        }

        .listing-sticky-submit {
            flex: 0 0 auto;
            padding: 11px 18px;
            border: 0;
            border-radius: 9px;
            background: #ff385c;
            color: #fff;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .listing-sticky-submit:hover {
            background: #e31c5f;
            transform: translateY(-1px);
        }

        #photos,
        #amenities,
        #location,
        #reviews {
            scroll-margin-top: 140px;
        }

        .booking-date-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            overflow: hidden;
            border: 1px solid #b8bec8;
            border-radius: 10px;
        }

        .booking-date-field {
            min-width: 0;
            padding: 10px;
        }

        .booking-date-field + .booking-date-field {
            border-left: 1px solid #b8bec8;
        }

        .booking-date-field label,
        .booking-guests-label {
            display: block;
            margin-bottom: 5px;
            color: #222;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.06em;
        }

        .booking-date-field input {
            width: 100%;
            min-width: 0;
            padding: 3px 0;
            border: 0;
            background: transparent;
            color: #333;
            font: inherit;
            font-size: 0.85rem;
        }

        .booking-date-field input:focus {
            outline: none;
        }

        .booking-date-row:focus-within,
        .booking-guests-trigger:focus-visible {
            outline: 2px solid #536175;
            outline-offset: 2px;
        }

        .booking-guests {
            position: relative;
            margin-top: 12px;
        }

        .booking-guests-trigger {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #b8bec8;
            border-radius: 10px;
            background: #fff;
            color: #333;
            font: inherit;
            text-align: left;
            cursor: pointer;
        }

        .booking-guests-trigger:hover {
            border-color: #536175;
        }

        .booking-guests-summary {
            display: block;
            font-size: 0.9rem;
        }

        .booking-guest-popover {
            margin-top: 8px;
            padding: 8px 14px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        }

        .booking-guest-popover[hidden] {
            display: none;
        }

        .booking-guest-counter {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 0;
        }

        .booking-guest-counter + .booking-guest-counter {
            border-top: 1px solid #eee;
        }

        .booking-guest-type {
            color: #222;
            font-weight: 600;
        }

        .booking-guest-control {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .booking-guest-control button {
            display: inline-flex;
            width: 32px;
            height: 32px;
            align-items: center;
            justify-content: center;
            border: 1px solid #87909d;
            border-radius: 50%;
            background: #fff;
            color: #333;
            font: inherit;
            font-size: 1.1rem;
            line-height: 1;
            cursor: pointer;
        }

        .booking-guest-control button:disabled {
            border-color: #d5d8de;
            color: #a5aab2;
            cursor: not-allowed;
        }

        .booking-guest-count {
            min-width: 18px;
            color: #222;
            text-align: center;
        }

        .booking-submit {
            width: 100%;
            margin-top: 16px;
            padding: 14px 18px;
            border: 0;
            border-radius: 10px;
            background: #ff385c;
            color: #fff;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .booking-submit:hover {
            background: #e31c5f;
            transform: translateY(-1px);
        }

        @media (max-width: 1100px) {
            .listing-booking-layout {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @media (max-width: 576px) {
            .show-container {
                width: 94%;
            }

            .listing-booking-card {
                padding: 16px;
            }

            .listing-sticky-bar {
                padding: 10px 3%;
            }

            .listing-sticky-inner {
                flex-wrap: wrap;
                gap: 10px;
            }

            .listing-sticky-nav {
                order: 3;
                width: 100%;
                overflow-x: auto;
                gap: 16px;
                padding: 2px 0;
            }

            .listing-sticky-details {
                flex-wrap: wrap;
                gap: 4px 10px;
                white-space: normal;
            }

            .listing-sticky-submit {
                padding: 10px 14px;
            }

            .booking-date-field {
                padding: 9px 7px;
            }
        }
    </style>

    <nav
        class="listing-sticky-bar"
        id="listing-sticky-bar"
        aria-label="Listing summary"
        aria-hidden="true"
        hidden
    >
        <div class="listing-sticky-inner">
            <div class="listing-sticky-nav">
                <a href="#photos">Photos</a>
                <% if (Array.isArray(listing.amenities) && listing.amenities.length > 0) { %>
                    <a href="#amenities">Amenities</a>
                <% } %>
                <a href="#reviews">Reviews</a>
                <a href="#location">Location</a>
            </div>
            <div class="listing-sticky-details">
                <span
                    class="listing-sticky-price"
                    id="sticky-price-summary"
                    data-nightly-price="<%= listing.price %>"
                >
                    <span class="listing-price-total">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                    <span class="listing-price-night-label">for 1 night</span>
                </span>
                <span class="listing-sticky-nightly">
                    &#8377;<%= listing.price.toLocaleString("en-IN") %> per night
                </span>
                <% if (stickyAverageRating !== null) { %>
                    <span class="listing-sticky-rating">
                        &#9733; <%= stickyAverageRating.toFixed(1) %> · <%= stickyReviewCount %>
                        <%= stickyReviewCount === 1 ? "review" : "reviews" %>
                    </span>
                <% } %>
            </div>
            <button
                class="listing-sticky-submit"
                id="listing-sticky-book-now"
                type="button"
            >Book Now!</button>
        </div>
    </nav>

    <div class="show-card">

        <%
            let listingImages = [];

            if (listing.images && listing.images.length > 0) {

                listingImages = listing.images;

            } else if (
                listing.image &&
                listing.image.url
            ) {

                listingImages = [
                    listing.image.url
                ];

            }
        %>

        <div class="listing-image-slider" id="photos">

            <% listingImages.forEach(function(image, index) { %>

                <img
                    src="<%= image %>"
                    class="listing-slide <%= index === 0 ? 'active-slide' : '' %>"
                    alt="listing image <%= index + 1 %>"
                >

            <% }); %>


            <% if (listingImages.length > 1) { %>

                <button
                    type="button"
                    class="listing-slide-btn listing-prev"
                    onclick="moveListingSlide(-1)"
                >
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <button
                    type="button"
                    class="listing-slide-btn listing-next"
                    onclick="moveListingSlide(1)"
                >
                    <i class="fa-solid fa-chevron-right"></i>
                </button>


                <div class="listing-slide-dots">

                    <% listingImages.forEach(function(image, index) { %>

                        <span
                            class="listing-dot <%= index === 0 ? 'active-dot' : '' %>"
                            onclick="goToListingSlide(<%= index %>)"
                        ></span>

                    <% }); %>

                </div>

            <% } %>

        </div>

        <div class="show-details">

            <div class="listing-booking-layout">
                <section class="listing-summary" aria-label="Listing summary">
                    <h3 class="show-title">
                        <%= listing.title %>
                    </h3>


                    <p class="show-description">
                        <%= listing.description %>
                    </p>

                    <p class="show-location">
                        <%= listing.location %>
                    </p>
                </section>

                <aside class="listing-booking-card" aria-label="Book this listing">
                    <form
                        id="listing-booking-form"
                        method="GET"
                        action="/listings/<%= listing._id %>/booking"
                    >
                        <p
                            class="booking-price-summary"
                            id="booking-price-summary"
                            data-nightly-price="<%= listing.price %>"
                        >
                            <span class="listing-price-total">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                            <span class="listing-price-night-label">for 1 night</span>
                        </p>
                        <div class="booking-date-row">
                            <div class="booking-date-field">
                                <label for="booking-check-in">CHECK-IN</label>
                                <input
                                    id="booking-check-in"
                                    name="checkIn"
                                    type="date"
                                    required
                                >
                            </div>
                            <div class="booking-date-field">
                                <label for="booking-check-out">CHECKOUT</label>
                                <input
                                    id="booking-check-out"
                                    name="checkOut"
                                    type="date"
                                    required
                                >
                            </div>
                        </div>

                        <div class="booking-guests">
                            <span class="booking-guests-label">GUESTS</span>
                            <button
                                id="booking-guests-trigger"
                                class="booking-guests-trigger"
                                type="button"
                                aria-expanded="false"
                                aria-controls="booking-guest-popover"
                            >
                                <span id="booking-guests-summary" class="booking-guests-summary">
                                    4 guests · 0 pets
                                </span>
                            </button>

                            <div
                                id="booking-guest-popover"
                                class="booking-guest-popover"
                                role="group"
                                aria-label="Choose guests"
                                hidden
                            >
                                <div class="booking-guest-counter" data-guest-type="adults" data-minimum="1">
                                    <span class="booking-guest-type">Adults</span>
                                    <span class="booking-guest-control">
                                        <button type="button" data-guest-change="-1" aria-label="Remove one adult">−</button>
                                        <span class="booking-guest-count" data-guest-count>4</span>
                                        <button type="button" data-guest-change="1" aria-label="Add one adult">+</button>
                                    </span>
                                </div>
                                <div class="booking-guest-counter" data-guest-type="children" data-minimum="0">
                                    <span class="booking-guest-type">Children</span>
                                    <span class="booking-guest-control">
                                        <button type="button" data-guest-change="-1" aria-label="Remove one child">−</button>
                                        <span class="booking-guest-count" data-guest-count>0</span>
                                        <button type="button" data-guest-change="1" aria-label="Add one child">+</button>
                                    </span>
                                </div>
                                <div class="booking-guest-counter" data-guest-type="pets" data-minimum="0">
                                    <span class="booking-guest-type">Pets</span>
                                    <span class="booking-guest-control">
                                        <button type="button" data-guest-change="-1" aria-label="Remove one pet">−</button>
                                        <span class="booking-guest-count" data-guest-count>0</span>
                                        <button type="button" data-guest-change="1" aria-label="Add one pet">+</button>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="adults" value="4" data-guest-value="adults">
                        <input type="hidden" name="children" value="0" data-guest-value="children">
                        <input type="hidden" name="pets" value="0" data-guest-value="pets">

                        <button class="booking-submit" type="submit">Book Now!</button>
                    </form>
                </aside>
            </div>

            <%
                const listingAmenities =
                    Array.isArray(listing.amenities) ? listing.amenities : [];

                function getAmenityIcon(amenity) {
                    const name = String(amenity).toLowerCase();

                    if (name.includes("wifi")) return "fa-wifi";
                    if (name.includes("kitchen") || name.includes("dining")) return "fa-utensils";
                    if (name.includes("parking") || name.includes("car")) return "fa-car";
                    if (name.includes("pool") || name.includes("swimming")) return "fa-person-swimming";
                    if (name.includes("lift") || name.includes("elevator")) return "fa-elevator";
                    if (name.includes("air conditioning") || name.includes("heater") || name.includes("heating") || name.includes("blanket") || name.includes("bedding")) return "fa-snowflake";
                    if (name.includes("washing") || name.includes("drying") || name.includes("laundry")) return "fa-soap";
                    if (name.includes("workspace") || name.includes("desk") || name.includes("office")) return "fa-briefcase";
                    if (name.includes("tv") || name.includes("hdtv") || name.includes("television")) return "fa-tv";
                    if (name.includes("hanger")) return "fa-shirt";
                    if (name.includes("iron")) return "fa-shirt";
                    if (name.includes("refrigerator") || name.includes("fridge") || name.includes("microwave") || name.includes("kettle")) return "fa-kitchen-set";
                    if (name.includes("camera") || name.includes("security")) return "fa-video";
                    if (name.includes("hot water") || name.includes("water")) return "fa-droplet";
                    if (name.includes("fire") || name.includes("smoke")) return "fa-fire-extinguisher";
                    if (name.includes("bed") || name.includes("linen")) return "fa-bed";
                    if (name.includes("toiletries") || name.includes("bath")) return "fa-bath";
                    if (name.includes("entrance") || name.includes("door")) return "fa-door-open";
                    if (name.includes("umbrella") || name.includes("rain")) return "fa-umbrella";

                    return "fa-check";
                }

                function getAmenityLabel(amenity) {
                    const name = String(amenity).trim().toLowerCase();

                    if (name === "free parking") return "Free parking on premises";
                    if (name === "tv / hdtv") return "43-inch HDTV";
                    if (name === "exterior security cameras") {
                        return "Exterior security cameras on property";
                    }

                    return amenity;
                }
            %>

            <% if (listingAmenities.length > 0) { %>
                <style>
                    .listing-amenities {
                        margin: 24px 0;
                        padding: 20px 0;
                        border-top: 1px solid #e5e7eb;
                        border-bottom: 1px solid #e5e7eb;
                    }

                    .listing-amenities h4,
                    .amenities-modal-content h4 {
                        margin: 0 0 16px;
                        color: #222;
                    }

                    .listing-amenities-grid,
                    .amenities-modal-grid {
                        display: grid;
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                        gap: 14px 22px;
                    }

                    .listing-amenity,
                    .amenities-modal-item {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        color: #333;
                    }

                    .listing-amenity i,
                    .amenities-modal-item i {
                        width: 20px;
                        color: #536175;
                        text-align: center;
                    }

                    .amenities-show-all {
                        margin-top: 18px;
                        padding: 0;
                        border: 0;
                        border-bottom: 1px solid currentColor;
                        background: none;
                        color: #222;
                        font: inherit;
                        font-weight: 600;
                        cursor: pointer;
                    }

                    .amenities-modal {
                        position: fixed;
                        inset: 0;
                        z-index: 2000;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 20px;
                        background: rgba(0, 0, 0, 0.55);
                    }

                    .amenities-modal[hidden] {
                        display: none;
                    }

                    .amenities-modal-content {
                        position: relative;
                        width: min(680px, 100%);
                        max-height: min(80vh, 720px);
                        overflow-y: auto;
                        padding: 28px;
                        border-radius: 14px;
                        background: #fff;
                    }

                    .amenities-modal-close {
                        position: absolute;
                        top: 12px;
                        right: 16px;
                        padding: 2px 8px;
                        border: 0;
                        background: transparent;
                        color: #222;
                        font-size: 1.8rem;
                        line-height: 1;
                        cursor: pointer;
                    }

                    @media (max-width: 576px) {
                        .amenities-modal-content {
                            padding: 24px 18px;
                        }

                        .listing-amenities-grid,
                        .amenities-modal-grid {
                            gap: 12px;
                        }
                    }
                </style>

            <% } %>

            <% if (listingAmenities.length > 0) { %>
                <section class="listing-amenities" id="amenities" aria-labelledby="listing-amenities-heading">
                    <h4 id="listing-amenities-heading">What this place offers</h4>
                    <div class="listing-amenities-grid">
                        <% listingAmenities.slice(0, 8).forEach(function(amenity) { %>
                            <div class="listing-amenity">
                                <i class="fa-solid <%= getAmenityIcon(amenity) %>" aria-hidden="true"></i>
                                <span><%= getAmenityLabel(amenity) %></span>
                            </div>
                        <% }); %>
                    </div>
                    <button
                        type="button"
                        class="amenities-show-all"
                        id="show-all-amenities"
                        aria-haspopup="dialog"
                        aria-controls="amenities-modal"
                    >Show all <%= listingAmenities.length %> amenities</button>
                </section>

                <div
                    class="amenities-modal"
                    id="amenities-modal"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="amenities-modal-heading"
                    hidden
                >
                    <div class="amenities-modal-content">
                        <button
                            type="button"
                            class="amenities-modal-close"
                            id="close-amenities-modal"
                            aria-label="Close amenities"
                        >&times;</button>
                        <h4 id="amenities-modal-heading">What this place offers</h4>
                        <div class="amenities-modal-grid">
                            <% listingAmenities.forEach(function(amenity) { %>
                                <div class="amenities-modal-item">
                                    <i class="fa-solid <%= getAmenityIcon(amenity) %>" aria-hidden="true"></i>
                                    <span><%= getAmenityLabel(amenity) %></span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- ============================= -->
            <!-- Location Map -->
            <!-- ============================= -->

            <% if (
                listing.coordinates &&
                listing.coordinates.lat !== undefined &&
                listing.coordinates.lng !== undefined
            ) { %>


                <div class="map-section" id="location">

                    <h4 class="map-heading">
                        Location on Map
                    </h4>


                    <!-- Small Map -->

                    <div
                        id="listing-map"
                        class="listing-map"
                        data-lat="<%= listing.coordinates.lat %>"
                        data-lng="<%= listing.coordinates.lng %>"
                        title="Click to enlarge map"
                    >
                    </div>


                    <p class="map-hint">
                        Click the map to enlarge
                    </p>

                </div>


                <!-- Large Map Modal -->

                <div
                    id="map-modal"
                    class="map-modal"
                >

                    <div class="map-modal-content">

                        <button
                            id="close-map"
                            class="map-close-btn"
                        >
                            &times;
                        </button>


                        <div
                            id="large-listing-map"
                            class="large-listing-map"
                        >
                        </div>

                    </div>

                </div>


            <% } else { %>


                <div class="map-unavailable" id="location">

                    <p>
                        Map location is not available for this listing.
                    </p>

                </div>


            <% } %>


            <p class="show-country">
                <%= listing.country %>
            </p>


            <!-- ================================= -->
            <!-- REVIEWS / COMMENTS -->
            <!-- ================================= -->

            <div class="reviews-section" id="reviews">

                <h4 class="reviews-heading">
                    Share Your Experience
                </h4>


                <% if (typeof currentUser !== "undefined" && currentUser) { %>


                    <!-- REVIEW FORM -->

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>/reviews"
                        class="review-form"
                    >


                        <div class="review-form-group">

                            <textarea
                                name="comment"
                                class="review-textarea"
                                placeholder="Tell us your experience."
                                required
                            ></textarea>

                        </div>


                        <!-- STAR RATING -->

                        <div class="rating-section">

                            <label class="rating-label">
                                Your Rating
                            </label>


                            <div class="star-rating">

                                <input
                                    type="radio"
                                    id="star-5"
                                    name="rating"
                                    value="5"
                                >

                                <label
                                    for="star-5"
                                    title="5 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-4-5"
                                    name="rating"
                                    value="4.5"
                                >

                                <label
                                    for="star-4-5"
                                    title="4.5 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-4"
                                    name="rating"
                                    value="4"
                                >

                                <label
                                    for="star-4"
                                    title="4 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-3-5"
                                    name="rating"
                                    value="3.5"
                                >

                                <label
                                    for="star-3-5"
                                    title="3.5 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-3"
                                    name="rating"
                                    value="3"
                                >

                                <label
                                    for="star-3"
                                    title="3 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-2-5"
                                    name="rating"
                                    value="2.5"
                                >

                                <label
                                    for="star-2-5"
                                    title="2.5 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-2"
                                    name="rating"
                                    value="2"
                                >

                                <label
                                    for="star-2"
                                    title="2 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-1-5"
                                    name="rating"
                                    value="1.5"
                                >

                                <label
                                    for="star-1-5"
                                    title="1.5 stars"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-1"
                                    name="rating"
                                    value="1"
                                >

                                <label
                                    for="star-1"
                                    title="1 star"
                                >
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star-0-5"
                                    name="rating"
                                    value="0.5"
                                >

                                <label
                                    for="star-0-5"
                                    title="0.5 stars"
                                >
                                    ★
                                </label>

                            </div>

                        </div>


                        <button
                            type="submit"
                            class="submit-btn review-submit-btn"
