<script src="/js/listing-booking.js"></script>
<script src="/js/listing-availability.js"></script>

<script>
    (() => {
        const bookingForm =
            document.getElementById("listing-booking-form");
        const bookingCard =
            document.querySelector(".listing-booking-card");
        const stickyBar =
            document.getElementById("listing-sticky-bar");
        const stickyBookNow =
            document.getElementById("listing-sticky-book-now");
        const checkInInput =
            document.getElementById("booking-check-in");
        const checkOutInput =
            document.getElementById("booking-check-out");
        const priceSummaries =
            document.querySelectorAll("[data-nightly-price]");
        const availabilityMessage =
            document.getElementById("booking-availability-message");
        const bookingCalendars =
            Array.from(document.querySelectorAll("[data-calendar-for]"));

        if (
            !bookingForm ||
            !bookingCard ||
            !stickyBar ||
            !stickyBookNow ||
            !checkInInput ||
            !checkOutInput ||
            !priceSummaries.length
        ) {
            return;
        }

        function isValidDateValue(value) {
            if (!/^\d{4}-\d{2}-\d{2}$/.test(value || "")) {
                return false;
            }

            const [year, month, day] = value.split("-").map(Number);
            const date = new Date(year, month - 1, day);
            return (
                date.getFullYear() === year &&
                date.getMonth() === month - 1 &&
                date.getDate() === day
            );
        }

        let unavailableRanges = [];
        let availabilityDataReady = true;

        try {
            const parsedRanges =
                JSON.parse(bookingForm.dataset.unavailableDateRanges || "[]");

            if (
                !Array.isArray(parsedRanges) ||
                parsedRanges.some((range) =>
                    !range ||
                    !isValidDateValue(range.from) ||
                    !isValidDateValue(range.to) ||
                    range.from > range.to
                )
            ) {
                throw new Error("Unavailable date ranges have an invalid format.");
            }

            unavailableRanges = parsedRanges;
        } catch (error) {
            availabilityDataReady = false;
            console.error("Could not load listing availability dates.", error);
            if (availabilityMessage) {
                availabilityMessage.hidden = false;
                availabilityMessage.textContent =
                    "Unavailable dates could not be loaded. Please refresh and try again.";
            }
            checkInInput.disabled = true;
            checkOutInput.disabled = true;
        }

        const nightlyPrice =
            Number(priceSummaries[0].dataset.nightlyPrice);
        const currencyFormatter =
            new Intl.NumberFormat("en-IN", {
                maximumFractionDigits: 0
            });

        function updatePriceSummaries() {
            let nights = 1;

            if (checkInInput.value && checkOutInput.value) {
                const checkInParts =
                    checkInInput.value.split("-").map(Number);
                const checkOutParts =
                    checkOutInput.value.split("-").map(Number);
                const checkInTime =
                    Date.UTC(
                        checkInParts[0],
                        checkInParts[1] - 1,
                        checkInParts[2]
                    );
                const checkOutTime =
                    Date.UTC(
                        checkOutParts[0],
                        checkOutParts[1] - 1,
                        checkOutParts[2]
                    );
                const selectedNights =
                    (checkOutTime - checkInTime) / 86400000;

                if (Number.isInteger(selectedNights) && selectedNights > 0) {
                    nights = selectedNights;
                }
            }

            const totalPrice =
                currencyFormatter.format(nightlyPrice * nights);
            const nightLabel = nights === 1 ? "night" : "nights";

            priceSummaries.forEach((summary) => {
                summary.textContent =
                    `₹${totalPrice} for ${nights} ${nightLabel}`;
            });
        }

        function updateStickyVisibility() {
            const shouldShow =
                bookingCard.getBoundingClientRect().bottom <= 60;

            stickyBar.hidden = !shouldShow;
            stickyBar.setAttribute("aria-hidden", String(!shouldShow));
        }

        function formatLocalDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, "0");
            const day = String(date.getDate()).padStart(2, "0");
            return `${year}-${month}-${day}`;
        }

        function isUnavailableDate(dateValue) {
            return unavailableRanges.some((range) =>
                range.from <= dateValue && dateValue <= range.to
            );
        }

        function hasUnavailableOverlap(checkIn, checkOut) {
            return unavailableRanges.some((range) =>
                checkIn <= range.to && checkOut > range.from
            );
        }

        function getMinimumDate(field) {
            if (field === "checkIn") {
                return formatLocalDate(new Date());
            }

            if (!isValidDateValue(checkInInput.value)) {
                return "";
            }

            const [year, month, day] = checkInInput.value.split("-").map(Number);
            return formatLocalDate(new Date(year, month - 1, day + 1));
        }

        let activeCalendar = null;
        let suppressFocusOpen = false;

        function renderCalendar(calendar) {
            const field = calendar.dataset.calendarFor;
            const input = field === "checkIn" ? checkInInput : checkOutInput;
            const monthLabel = calendar.querySelector("[data-calendar-month-label]");
            const daysContainer = calendar.querySelector("[data-calendar-days]");
            const monthValue = calendar.dataset.month;
            const [year, month] = monthValue.split("-").map(Number);
            const monthDate = new Date(year, month - 1, 1);
            const daysInMonth = new Date(year, month, 0).getDate();
            const firstWeekday = monthDate.getDay();
            const minimumDate = getMinimumDate(field);

            monthLabel.textContent = new Intl.DateTimeFormat("en", {
                month: "long",
                year: "numeric"
            }).format(monthDate);
            daysContainer.replaceChildren();

            for (let index = 0; index < firstWeekday; index += 1) {
                const emptyDay = document.createElement("span");
                emptyDay.className =
                    "booking-calendar-day is-outside-month";
                emptyDay.setAttribute("aria-hidden", "true");
                daysContainer.append(emptyDay);
            }

            for (let day = 1; day <= daysInMonth; day += 1) {
                const dateValue =
                    `${monthValue}-${String(day).padStart(2, "0")}`;
                const isUnavailable = isUnavailableDate(dateValue);
                const isBeforeMinimum =
                    !minimumDate || dateValue < minimumDate;
                const overlapsUnavailableRange =
                    field === "checkOut" &&
                    isValidDateValue(checkInInput.value) &&
                    hasUnavailableOverlap(checkInInput.value, dateValue);
                const dateButton = document.createElement("button");
                dateButton.className = "booking-calendar-day";
                dateButton.type = "button";
                dateButton.textContent = String(day);
                dateButton.dataset.date = dateValue;
                dateButton.disabled =
                    !availabilityDataReady ||
                    isUnavailable ||
                    isBeforeMinimum ||
                    overlapsUnavailableRange ||
                    (field === "checkOut" &&
                        dateValue <= checkInInput.value);
                dateButton.setAttribute(
                    "aria-label",
                    `${new Intl.DateTimeFormat("en", {
                        dateStyle: "full"
                    }).format(new Date(year, month - 1, day))}` +
                    (isUnavailable ? ", unavailable" : "")
                );

                if (isUnavailable) {
                    dateButton.classList.add("is-unavailable");
                }
                if (input.value === dateValue) {
                    dateButton.classList.add("is-selected");
                    dateButton.setAttribute("aria-pressed", "true");
                } else {
                    dateButton.setAttribute("aria-pressed", "false");
                }
                daysContainer.append(dateButton);
            }

            const totalCells = firstWeekday + daysInMonth;
            for (let index = totalCells; index < 42; index += 1) {
                const emptyDay = document.createElement("span");
                emptyDay.className =
                    "booking-calendar-day is-outside-month";
                emptyDay.setAttribute("aria-hidden", "true");
                daysContainer.append(emptyDay);
            }

            const previousMonthButton =
                calendar.querySelector('[data-calendar-month-change="-1"]');
            const previousMonth = new Date(year, month - 2, 1);
            previousMonthButton.disabled =
                formatLocalDate(previousMonth).slice(0, 7) <
                minimumDate.slice(0, 7);
        }

        function openCalendar(field) {
            if (!availabilityDataReady) {
                return;
            }
            if (field === "checkOut" && !isValidDateValue(checkInInput.value)) {
                if (availabilityMessage) {
                    availabilityMessage.hidden = false;
                    availabilityMessage.textContent =
                        "Choose a check-in date before selecting checkout.";
                }
                checkInInput.focus();
                return;
            }

            checkInInput.setAttribute(
                "aria-expanded",
                String(field === "checkIn")
            );
            checkOutInput.setAttribute(
                "aria-expanded",
                String(field === "checkOut")
            );
            bookingCalendars.forEach((calendar) => {
                const isActive = calendar.dataset.calendarFor === field;
                calendar.hidden = !isActive;
                const input =
                    field === "checkIn" ? checkInInput : checkOutInput;
                if (isActive) {
                    const value = input.value || getMinimumDate(field);
                    const [year, month] = value.split("-").map(Number);
                    calendar.dataset.month =
                        `${year}-${String(month).padStart(2, "0")}`;
                    renderCalendar(calendar);
                    activeCalendar = calendar;
                }
            });
        }

        function closeCalendar(restoreFocus) {
            if (!activeCalendar) {
                return;
            }

            const field = activeCalendar.dataset.calendarFor;
            activeCalendar.hidden = true;
            activeCalendar = null;
            const input =
                field === "checkIn" ? checkInInput : checkOutInput;
            input.setAttribute("aria-expanded", "false");
            if (restoreFocus && document.activeElement !== input) {
                suppressFocusOpen = true;
                input.focus();
            }
        }

        bookingCalendars.forEach((calendar) => {
            const field = calendar.dataset.calendarFor;
            const input =
                field === "checkIn" ? checkInInput : checkOutInput;

            calendar.querySelectorAll("[data-calendar-month-change]").forEach(
                (button) => {
                    button.addEventListener("click", function () {
                        const [year, month] =
                            calendar.dataset.month.split("-").map(Number);
                        const nextMonth = new Date(
                            year,
                            month - 1 + Number(button.dataset.calendarMonthChange),
                            1
                        );
                        calendar.dataset.month =
                            `${nextMonth.getFullYear()}-${String(
                                nextMonth.getMonth() + 1
                            ).padStart(2, "0")}`;
                        renderCalendar(calendar);
                    });
                }
            );

            calendar.querySelector("[data-calendar-days]").addEventListener(
                "click",
                function (event) {
                    const dateButton =
                        event.target.closest("[data-date]");
                    if (!dateButton || dateButton.disabled) {
                        return;
                    }

                    input.value = dateButton.dataset.date;
                    input.dispatchEvent(
                        new Event("change", { bubbles: true })
                    );
                    closeCalendar(true);

                    if (availabilityMessage) {
                        availabilityMessage.hidden = true;
                        availabilityMessage.textContent = "";
                    }
                }
            );

            input.addEventListener("focus", function () {
                if (suppressFocusOpen) {
                    suppressFocusOpen = false;
                    return;
                }
                openCalendar(field);
            });
            input.addEventListener("click", function () {
                openCalendar(field);
            });
            input.addEventListener("keydown", function (event) {
                if (
                    event.key === "Enter" ||
                    event.key === " " ||
                    event.key === "ArrowDown"
                ) {
                    event.preventDefault();
                    openCalendar(field);
                }
            });
        });

        document.addEventListener("click", function (event) {
            if (
                activeCalendar &&
                !activeCalendar.contains(event.target) &&
                event.target !== checkInInput &&
                event.target !== checkOutInput
            ) {
                closeCalendar(false);
            }
        });
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && activeCalendar) {
                closeCalendar(true);
            }
        });

        checkInInput.addEventListener("change", updatePriceSummaries);
        checkOutInput.addEventListener("change", updatePriceSummaries);
        let availabilityCheckInProgress = false;
        bookingForm.addEventListener("submit", async function (event) {
            event.preventDefault();

            if (
                !availabilityDataReady
            ) {
                return;
            }

            if (
                !isValidDateValue(checkInInput.value) ||
                !isValidDateValue(checkOutInput.value)
            ) {
                if (availabilityMessage) {
                    availabilityMessage.hidden = false;
                    availabilityMessage.textContent =
                        !checkInInput.value
                            ? "Choose a check-in date first."
                            : "Choose both a valid check-in and checkout date.";
                }
                return;
            }

            if (checkOutInput.value <= checkInInput.value) {
                if (availabilityMessage) {
                    availabilityMessage.hidden = false;
                    availabilityMessage.textContent =
                        "Checkout must be later than check-in.";
                }
                return;
            }

            if (availabilityCheckInProgress) {
                return;
            }

            availabilityCheckInProgress = true;
            if (availabilityMessage) {
                availabilityMessage.hidden = false;
                availabilityMessage.textContent = "Checking availability…";
            }

            try {
                const availabilityUrl =
                    new URL(bookingForm.action, window.location.origin);
                availabilityUrl.pathname =
                    availabilityUrl.pathname.replace(/\/booking$/, "/availability");
                availabilityUrl.searchParams.set("checkIn", checkInInput.value);
                availabilityUrl.searchParams.set("checkOut", checkOutInput.value);

                const response =
                    await fetch(availabilityUrl, {
                        headers: { Accept: "application/json" },
                        credentials: "same-origin"
                    });
                const result = await response.json();

                if (!response.ok || !result.available) {
                    if (availabilityMessage) {
                        availabilityMessage.textContent =
                            result.message ||
                            "We couldn't check availability right now. Please try again.";
                    }
                    availabilityCheckInProgress = false;
                    return;
                }

                const bookingUrl =
                    new URL(bookingForm.action, window.location.origin);
                bookingUrl.search =
                    new URLSearchParams(new FormData(bookingForm)).toString();
                window.location.assign(bookingUrl.toString());
            } catch (error) {
                console.error("Could not check listing availability.", error);
                if (availabilityMessage) {
                    availabilityMessage.hidden = false;
                    availabilityMessage.textContent =
                        "We couldn't check availability right now. Please try again.";
                }
                availabilityCheckInProgress = false;
            }
        });
        stickyBookNow.addEventListener("click", function () {
            bookingForm.requestSubmit();
        });
        window.addEventListener("scroll", updateStickyVisibility, {
            passive: true
        });
        window.addEventListener("resize", updateStickyVisibility);

        updatePriceSummaries();
        updateStickyVisibility();
    })();
</script>

<script>
    (() => {
        const amenitiesModal =
            document.getElementById("amenities-modal");
        const showAmenitiesButton =
            document.getElementById("show-all-amenities");
        const closeAmenitiesButton =
            document.getElementById("close-amenities-modal");

        if (!amenitiesModal || !showAmenitiesButton || !closeAmenitiesButton) {
            return;
        }

        let previousBodyOverflow = "";

        function closeAmenitiesModal() {
            amenitiesModal.hidden = true;
            document.body.style.overflow = previousBodyOverflow;
            showAmenitiesButton.focus();
        }

        showAmenitiesButton.addEventListener("click", function () {
            previousBodyOverflow = document.body.style.overflow;
            amenitiesModal.hidden = false;
            document.body.style.overflow = "hidden";
            closeAmenitiesButton.focus();
        });

        closeAmenitiesButton.addEventListener(
            "click",
            closeAmenitiesModal
        );

        amenitiesModal.addEventListener("click", function (event) {
            if (event.target === amenitiesModal) {
                closeAmenitiesModal();
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && !amenitiesModal.hidden) {
                closeAmenitiesModal();
            }
        });
    })();
</script>


