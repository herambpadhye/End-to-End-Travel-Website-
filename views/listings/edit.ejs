<% layout("/layouts/boilerplate") %>

<div class="new-listing-container">

    <h2 class="form-heading">
        Edit your Listing
    </h2>

    <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=PUT"
        class="listing-form"
        id="editForm"
        enctype="multipart/form-data"
    >

        <div class="form-group">
            <label>Title</label>

            <input
                type="text"
                name="listing[title]"
                value="<%= listing.title %>"
                required
            >

            <span class="error-msg"></span>
        </div>


        <div class="form-group">
            <label>Description</label>

            <textarea
                name="listing[description]"
                required
            ><%= listing.description %></textarea>

            <span class="error-msg"></span>
        </div>


        <!-- ================================= -->
        <!-- IMAGE UPLOAD -->
        <!-- ================================= -->

        <div class="form-group">

            <label>Upload Images</label>

            <input
                type="file"
                name="listingImages"
                id="listingImages"
                accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
                multiple
            >

            <small style="margin-top: 6px; color: #666;">
                Select 1 to 16 images. JPG, JPEG, PNG, WEBP, GIF or AVIF.
                Leave empty to keep the existing images.
            </small>

            <span
                id="imageError"
                class="error-msg"
            ></span>

        </div>


        <!-- ================================= -->
        <!-- IMAGE PREVIEW -->
        <!-- ================================= -->

        <div
            id="imagePreview"
            style="
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 20px;
            "
        >

            <% if (listing.images && listing.images.length > 0) { %>

                <% listing.images.forEach(function(image) { %>

                    <div
                        style="
                            width: 100px;
                            height: 80px;
                            border-radius: 8px;
                            overflow: hidden;
                            border: 1px solid #ddd;
                        "
                    >
                        <img
                            src="<%= image %>"
                            alt="Existing listing image"
                            style="
                                width: 100%;
                                height: 100%;
                                object-fit: cover;
                            "
                        >
                    </div>

                <% }) %>

            <% } else if (listing.image && listing.image.url) { %>

                <div
                    style="
                        width: 100px;
                        height: 80px;
                        border-radius: 8px;
                        overflow: hidden;
                        border: 1px solid #ddd;
                    "
                >
                    <img
                        src="<%= listing.image.url %>"
                        alt="Existing listing image"
                        style="
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                        "
                    >
                </div>

            <% } %>

        </div>


        <div class="form-row">

            <div class="form-group">

                <label>Price</label>

                <input
                    type="number"
                    name="listing[price]"
                    value="<%= listing.price %>"
                    required
                >

                <span class="error-msg"></span>

            </div>


            <div class="form-group">

                <label>Country</label>

                <input
                    type="text"
                    name="listing[country]"
                    value="<%= listing.country %>"
                    required
                >

                <span class="error-msg"></span>

            </div>

        </div>


        <div class="form-group">

            <label>Location</label>

            <input
                type="text"
                name="listing[location]"
                value="<%= listing.location %>"
                required
            >

            <span class="error-msg"></span>

        </div>

        <div class="form-group">
            <label>Property name</label>
            <input
                type="text"
                name="listing[propertyName]"
                value="<%= listing.propertyName || '' %>"
            >
            <span class="error-msg"></span>
        </div>

        <div class="form-group">
            <label>Nearby landmark</label>
            <input
                type="text"
                name="listing[landmark]"
                value="<%= listing.landmark || '' %>"
            >
            <span class="error-msg"></span>
        </div>

        <div class="form-group">
            <label>Locality / area</label>
            <input
                type="text"
                name="listing[locality]"
                value="<%= listing.locality || '' %>"
            >
            <span class="error-msg"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>City</label>
                <input
                    type="text"
                    name="listing[city]"
                    value="<%= listing.city || '' %>"
                >
                <span class="error-msg"></span>
            </div>

            <div class="form-group">
                <label>State</label>
                <input
                    type="text"
                    name="listing[state]"
                    value="<%= listing.state || '' %>"
                >
                <span class="error-msg"></span>
            </div>
        </div>

        <div class="form-group">
            <label>PIN code</label>
            <input
                type="text"
                name="listing[pincode]"
                value="<%= listing.pincode || '' %>"
                inputmode="numeric"
                autocomplete="postal-code"
            >
            <span class="error-msg"></span>
            <button
                type="button"
                class="submit-btn edit-search-btn"
                id="edit-search-location"
            >
                Search
            </button>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Latitude</label>
                <input
                    type="number"
                    name="listing[coordinates][lat]"
                    value="<%= listing.coordinates && listing.coordinates.lat != null ? listing.coordinates.lat : '' %>"
                    step="any"
                >
                <span class="error-msg"></span>
            </div>

            <div class="form-group">
                <label>Longitude</label>
                <input
                    type="number"
                    name="listing[coordinates][lng]"
                    value="<%= listing.coordinates && listing.coordinates.lng != null ? listing.coordinates.lng : '' %>"
                    step="any"
                >
                <span class="error-msg"></span>
            </div>
        </div>

        <div class="form-group">
            <small
                id="listing-location-status"
                role="status"
                aria-live="polite"
            ></small>
            <div
                id="listing-location-map"
                role="application"
                aria-label="Select the exact property location"
                style="height: 360px; width: 100%;"
            ></div>
        </div>

        <button
            type="submit"
            class="submit-btn"
        >
            Edit
        </button>

    </form>

</div>
</div>
<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

    const editAddressFields = {
        location:
            document.querySelector('input[name="listing[location]"]'),
        propertyName:
            document.querySelector('input[name="listing[propertyName]"]'),
        landmark:
            document.querySelector('input[name="listing[landmark]"]'),
        locality:
            document.querySelector('input[name="listing[locality]"]'),
        city:
            document.querySelector('input[name="listing[city]"]'),
        state:
            document.querySelector('input[name="listing[state]"]'),
        country:
            document.querySelector('input[name="listing[country]"]'),
        postalCode:
            document.querySelector('input[name="listing[pincode]"]')
    };
    const editLatitudeInput =
        document.querySelector('input[name="listing[coordinates][lat]"]');
    const editLongitudeInput =
        document.querySelector('input[name="listing[coordinates][lng]"]');
    const editLocationStatus =
        document.getElementById("listing-location-status");
    const editSearchButton =
        document.getElementById("edit-search-location");
    const manuallyEditedAddressFields = new Set();

    Object.values(editAddressFields).forEach(function (input) {
        if (input) {
            input.addEventListener("input", function (event) {
                if (event.isTrusted) {
                    manuallyEditedAddressFields.add(input);
                }
            });
        }
    });

    function showEditLocationStatus(message) {
        if (editLocationStatus) {
            editLocationStatus.textContent = message;
        }
    }

    if (
        typeof L !== "undefined" &&
        document.getElementById("listing-location-map") &&
        editLatitudeInput &&
        editLongitudeInput
    ) {
        const editMapElement =
            document.getElementById("listing-location-map");
        const editMap =
            L.map(editMapElement).setView([20, 0], 2);

        L.tileLayer(
            "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors'
            }
        ).addTo(editMap);

        let editMarker = null;
        let forwardLookupId = 0;
        let reverseLookupId = 0;
        let forwardLookupController = null;
        let applyingReverseSuggestions = false;

        function readCoordinates() {
            const latitude = Number(editLatitudeInput.value);
            const longitude = Number(editLongitudeInput.value);

            if (
                editLatitudeInput.value.trim() === "" ||
                editLongitudeInput.value.trim() === "" ||
                !Number.isFinite(latitude) ||
                latitude < -90 ||
                latitude > 90 ||
                !Number.isFinite(longitude) ||
                longitude < -180 ||
                longitude > 180
            ) {
                return null;
            }

            return { latitude, longitude };
        }

        function setEditMarker(latitude, longitude, updateInputs = true) {
            if (editMarker) {
                editMarker.setLatLng([latitude, longitude]);
            } else {
                editMarker =
                    L.marker([latitude, longitude], {
                        draggable: true
                    }).addTo(editMap);

                editMarker.on("dragstart", function () {
                    reverseLookupId += 1;
                    invalidateForwardLookup();
                });
                editMarker.on("dragend", function () {
                    const position = editMarker.getLatLng();
                    updateEditCoordinates(position.lat, position.lng);
                    reverseGeocodeEditLocation(position.lat, position.lng);
                });
            }

            if (updateInputs) {
                updateEditCoordinates(latitude, longitude);
            }
        }

        function updateEditCoordinates(latitude, longitude) {
            editLatitudeInput.value = latitude.toFixed(6);
            editLongitudeInput.value = longitude.toFixed(6);
        }

        function invalidateForwardLookup() {
            forwardLookupId += 1;

            if (forwardLookupController) {
                forwardLookupController.abort();
                forwardLookupController = null;
            }

            editSearchButton.disabled = false;
            editSearchButton.textContent = "Search";
            editSearchButton.setAttribute("aria-busy", "false");
        }

        function buildEditSearchAddress() {
            return [
                editAddressFields.landmark.value.trim(),
                editAddressFields.locality.value.trim(),
                editAddressFields.city.value.trim(),
                editAddressFields.state.value.trim(),
                editAddressFields.country.value.trim(),
                editAddressFields.postalCode.value.trim()
            ]
                .filter(Boolean)
                .join(", ");
        }

        function hasEnoughAddressDetails() {
            return Boolean(
                editAddressFields.country.value.trim() &&
                editAddressFields.city.value.trim() &&
                (
                    editAddressFields.landmark.value.trim() ||
                    editAddressFields.locality.value.trim() ||
                    editAddressFields.state.value.trim() ||
                    editAddressFields.postalCode.value.trim()
                )
            );
        }

        function suggestEditAddressField(fieldName, value) {
            const input = editAddressFields[fieldName];

            if (
                input &&
                value &&
                !input.value.trim() &&
                !manuallyEditedAddressFields.has(input)
            ) {
                input.value = value;
            }
        }

        async function reverseGeocodeEditLocation(latitude, longitude) {
            const lookupId = ++reverseLookupId;

            showEditLocationStatus(
                "Looking up nearby address details..."
            );

            try {
                const response = await fetch(
                    `/travel/reverse-geocode?latitude=${encodeURIComponent(latitude)}` +
                    `&longitude=${encodeURIComponent(longitude)}`
                );
                const result = await response.json();

                if (lookupId !== reverseLookupId) {
                    return;
                }

                if (
                    !response.ok ||
                    !result.success ||
                    !result.address ||
                    typeof result.address !== "object"
                ) {
                    showEditLocationStatus(
                        "Address suggestions are unavailable. You can enter the address manually."
                    );
                    return;
                }

                const address = result.address;
                const locality =
                    address.neighbourhood ||
                    address.suburb ||
                    address.quarter ||
                    address.residential ||
                    address.city_district ||
                    "";
                const city =
                    address.city ||
                    address.town ||
                    address.village ||
                    address.municipality ||
                    "";
                const landmark =
                    address.amenity ||
                    address.tourism ||
                    address.historic ||
                    address.leisure ||
                    address.shop ||
                    "";

                applyingReverseSuggestions = true;
                suggestEditAddressField("landmark", landmark);
                suggestEditAddressField("locality", locality);
                suggestEditAddressField("city", city);
                suggestEditAddressField("state", address.state || "");
                suggestEditAddressField("postalCode", address.postcode || "");
                suggestEditAddressField("country", address.country || "");
                suggestEditAddressField("location", city || locality);
                applyingReverseSuggestions = false;

                showEditLocationStatus(
                    "Address suggestions loaded. Check the details and adjust the marker if needed."
                );
            } catch {
                if (lookupId === reverseLookupId) {
                    applyingReverseSuggestions = false;
                    showEditLocationStatus(
                        "Address suggestions are unavailable. You can enter the address manually."
                    );
                }
            }
        }

        async function lookupEditAddress() {
            const searchAddress = buildEditSearchAddress();

            if (!searchAddress || !hasEnoughAddressDetails()) {
                showEditLocationStatus(
                    "Enter a city and country, plus a nearby address detail, before searching."
                );
                return;
            }

            if (editSearchButton.disabled) {
                return;
            }

            const lookupId = ++forwardLookupId;
            const controller = new AbortController();
            forwardLookupController = controller;
            editSearchButton.disabled = true;
            editSearchButton.textContent = "Searching...";
            editSearchButton.setAttribute("aria-busy", "true");

            showEditLocationStatus("Searching for this address...");

            try {
                const response = await fetch(
                    `/travel/geocode?location=${encodeURIComponent(searchAddress)}`,
                    { signal: controller.signal }
                );
                const result = await response.json();

                if (
                    lookupId !== forwardLookupId ||
                    searchAddress !== buildEditSearchAddress()
                ) {
                    return;
                }

                const latitude = Number(result.latitude);
                const longitude = Number(result.longitude);

                if (
                    !response.ok ||
                    !result.success ||
                    !Number.isFinite(latitude) ||
                    latitude < -90 ||
                    latitude > 90 ||
                    !Number.isFinite(longitude) ||
                    longitude < -180 ||
                    longitude > 180
                ) {
                    showEditLocationStatus(
                        response.status === 404
                            ? "No matching location found. Check the address and try again."
                            : "Location lookup is temporarily unavailable."
                    );
                    return;
                }

                editMap.setView([latitude, longitude], 16);
                setEditMarker(latitude, longitude);
                showEditLocationStatus(
                    "Location detected. Drag the marker to adjust it if needed."
                );
            } catch (error) {
                if (
                    error.name !== "AbortError" &&
                    lookupId === forwardLookupId
                ) {
                    showEditLocationStatus(
                        "Location lookup is temporarily unavailable."
                    );
                }
            } finally {
                if (lookupId === forwardLookupId) {
                    forwardLookupController = null;
                    editSearchButton.disabled = false;
                    editSearchButton.textContent = "Search";
                    editSearchButton.setAttribute("aria-busy", "false");
                }
            }
        }

        function handleEditAddressChange() {
            if (applyingReverseSuggestions) {
                return;
            }

            const searchWasInProgress =
                forwardLookupController !== null;
            invalidateForwardLookup();
            reverseLookupId += 1;

            if (searchWasInProgress) {
                showEditLocationStatus(
                    "Address changed. Select Search to look up the updated address."
                );
            }
        }

        const savedCoordinates = readCoordinates();

        if (savedCoordinates) {
            editMap.setView(
                [savedCoordinates.latitude, savedCoordinates.longitude],
                16
            );
            setEditMarker(
                savedCoordinates.latitude,
                savedCoordinates.longitude,
                false
            );
        } else {
            showEditLocationStatus(
                "Enter the address and select Search to locate the property."
            );
        }

        [
            editAddressFields.landmark,
            editAddressFields.locality,
            editAddressFields.city,
            editAddressFields.state,
            editAddressFields.country,
            editAddressFields.postalCode
        ].forEach(function (input) {
            input.addEventListener("input", handleEditAddressChange);
            input.addEventListener("change", handleEditAddressChange);
        });

        editSearchButton.addEventListener(
            "click",
            lookupEditAddress
        );

        editMap.on("click", function (event) {
            invalidateForwardLookup();
            reverseLookupId += 1;
            setEditMarker(event.latlng.lat, event.latlng.lng);
            reverseGeocodeEditLocation(
                event.latlng.lat,
                event.latlng.lng
            );
        });

        [editLatitudeInput, editLongitudeInput].forEach(function (input) {
            input.addEventListener("change", function () {
                const coordinates = readCoordinates();

                if (coordinates) {
                    editMap.setView(
                        [coordinates.latitude, coordinates.longitude],
                        16
                    );
                    setEditMarker(
                        coordinates.latitude,
                        coordinates.longitude
                    );
                }
            });
        });
    } else {
        editSearchButton.disabled = true;
        showEditLocationStatus(
            "The map could not be loaded. Enter coordinates manually."
        );
    }


    /* ==========================================
       EDIT FORM VALIDATION
    ========================================== */

    document
        .getElementById("editForm")
        .addEventListener("submit", function(e) {

            let isValid = true;

            document
                .querySelectorAll(".form-group")
                .forEach(group => {

                    const input =
                        group.querySelector(
                            "input:not([type='file']), textarea"
                        );

                    const errorMsg =
                        group.querySelector(".error-msg");

                    if (
                        input &&
                        input.required &&
                        !input.value.trim()
                    ) {

                        errorMsg.innerText =
                            "This field is required";

                        input.style.border =
                            "2px solid red";

                        isValid = false;

                    } else if (input) {

                        errorMsg.innerText = "";

                        input.style.border =
                            "1px solid #ccc";
                    }


                    /* Price validation */

                    if (
                        input &&
                        input.name === "listing[price]" &&
                        input.value < 0
                    ) {

                        errorMsg.innerText =
                            "Price cannot be negative";

                        input.style.border =
                            "2px solid red";

                        isValid = false;
                    }

                });


            /* ==========================================
               IMAGE VALIDATION
            ========================================== */

            const imageInput =
                document.getElementById("listingImages");

            const imageError =
                document.getElementById("imageError");

            imageError.innerText = "";

            const files =
                imageInput.files;


            /* Maximum 16 images */

            if (files.length > 16) {

                imageError.innerText =
                    "You can upload maximum 16 images.";

                isValid = false;
            }


            /* Check file types */

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp",
                "image/gif",
                "image/avif"
            ];


            for (let i = 0; i < files.length; i++) {

                if (!allowedTypes.includes(files[i].type)) {

                    imageError.innerText =
                        "Only JPG, JPEG, PNG, WEBP, GIF or AVIF images are allowed.";

                    isValid = false;

                    break;
                }
            }


            if (!isValid) {

                e.preventDefault();
            }

        });


    /* ==========================================
       IMAGE PREVIEW
    ========================================== */

    document
        .getElementById("listingImages")
        .addEventListener("change", function() {

            const preview =
                document.getElementById("imagePreview");

            const imageError =
                document.getElementById("imageError");

            preview.innerHTML = "";

            imageError.innerText = "";

            const files = this.files;


            if (files.length === 0) {
                return;
            }


            if (files.length > 16) {

                imageError.innerText =
                    "You can upload maximum 16 images.";

                this.value = "";

                return;
            }


            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp",
                "image/gif",
                "image/avif"
            ];


            for (let i = 0; i < files.length; i++) {

                if (!allowedTypes.includes(files[i].type)) {

                    imageError.innerText =
                        "Only JPG, JPEG, PNG, WEBP, GIF or AVIF images are allowed.";

                    this.value = "";

                    preview.innerHTML = "";

                    return;
                }


                const reader =
                    new FileReader();


                reader.onload = function(event) {

                    const wrapper =
                        document.createElement("div");

                    wrapper.style.width = "100px";
                    wrapper.style.height = "80px";
                    wrapper.style.borderRadius = "8px";
                    wrapper.style.overflow = "hidden";
                    wrapper.style.border = "1px solid #ddd";


                    const img =
                        document.createElement("img");

                    img.src =
                        event.target.result;

                    img.style.width = "100%";
                    img.style.height = "100%";
                    img.style.objectFit = "cover";


                    wrapper.appendChild(img);

                    preview.appendChild(wrapper);
                };


                reader.readAsDataURL(files[i]);
            }

        });

</script>

<style>
    .edit-search-btn {
        width: auto;
        min-width: 120px;
        margin-top: 8px;
        align-self: flex-start;
    }

    .edit-search-btn:disabled {
        cursor: wait;
        opacity: 0.7;
    }
</style>