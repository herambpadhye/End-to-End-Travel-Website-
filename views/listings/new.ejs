<% layout("/layouts/boilerplate") %>

<div class="new-listing-container">

    <h2 class="form-heading">
        Create a New Listing
    </h2>


    <form
        method="POST"
        action="/listings"
        class="listing-form"
        id="newForm"
        enctype="multipart/form-data"
    >

        <!-- ======================================== -->
        <!-- TITLE -->
        <!-- ======================================== -->

        <div class="form-group">

            <label>Title</label>

            <input
                name="listing[title]"
                placeholder="Add a catchy title"
                type="text"
                required
            />

            <span class="error-msg"></span>

        </div>

        <!-- ======================================== -->
        <!-- LOCATION -->
        <!-- ======================================== -->

        <div class="form-group">

            <label>Location</label>

            <input
                name="listing[location]"
                type="text"
                required
            />

            <small>Keep this existing listing location field; enter the property's city or general destination.</small>

            <span class="error-msg"></span>

        </div>

        <div class="form-group">
            <label>Property name</label>
            <input
                name="listing[propertyName]"
                type="text"
                placeholder="Enter the property's name"
                required
            />
            <span class="error-msg"></span>

        </div>

        <div class="form-group">
            <label>Nearby landmark</label>
            <input
                name="listing[landmark]"
                type="text"
                placeholder="Enter a nearby landmark"
                required
            />
            <span class="error-msg"></span>
        </div>

        <div class="form-group">
            <label>Locality / area</label>
            <input
                name="listing[locality]"
                type="text"
                placeholder="Enter the locality or area"
                required
            />
            <span class="error-msg"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>City</label>
                <input
                    name="listing[city]"
                    type="text"
                    placeholder="Enter the city"
                    required
                />
                <span class="error-msg"></span>
            </div>

            <div class="form-group">
                <label>State</label>
                <input
                    name="listing[state]"
                    type="text"
                    placeholder="Enter the state"
                    required
                />
                <span class="error-msg"></span>
            </div>
        </div>

        <div class="form-group">
            <label>PIN code</label>
            <input
                name="listing[pinCode]"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                placeholder="Enter the PIN code"
                required
            />
            <button
                type="button"
                class="submit-btn listing-search-btn"
                id="listing-search-location"
            >
                Search
            </button>
            <span class="error-msg"></span>
        </div>

        <div class="form-group">
            <small
                id="listing-location-status"
                role="status"
                aria-live="polite"
            ></small>
            <div
                id="listing-location-map"
                role="application"
                aria-label="Select the exact property location"
                style="height: 360px; width: 100%;"
            ></div>
        </div>

        <input
            id="listing-latitude"
            name="listing[coordinates][lat]"
            type="hidden"
        />
        <input
            id="listing-longitude"
            name="listing[coordinates][lng]"
            type="hidden"
        />

        <!-- ======================================== -->
        <!-- DESCRIPTION -->
        <!-- ======================================== -->

        <div class="form-group">

            <label>Description</label>

            <textarea
                name="listing[description]"
                required
            ></textarea>

            <span class="error-msg"></span>

        </div>

        <!-- ======================================== -->
        <!-- AMENITIES -->
        <!-- ======================================== -->

        <section class="amenities-section">

            <h3>What this place offers</h3>

            <div class="amenities-group">
                <h4>Basic Amenities</h4>
                <div class="amenities-options">
                    <label><input type="checkbox" name="listing[amenities]" value="Wifi" checked /> Wifi</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Kitchen" checked /> Kitchen</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Free parking" checked /> Free parking</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Hot water" checked /> Hot water</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Bed linen" checked /> Bed linen</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Towels" checked /> Towels</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Toiletries" checked /> Toiletries</label>
                    <label><input type="checkbox" name="listing[amenities]" value="TV / HDTV" checked /> TV / HDTV</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Washing machine" checked /> Washing machine</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Dining area" checked /> Dining area</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Refrigerator" checked /> Refrigerator</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Microwave" checked /> Microwave</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Electric kettle" checked /> Electric kettle</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Wardrobe / storage" checked /> Wardrobe / storage</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Hangers" checked /> Hangers</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Iron" checked /> Iron</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Clothes drying rack" checked /> Clothes drying rack</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Seating / living area" checked /> Seating / living area</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Dedicated workspace" checked /> Dedicated workspace</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Smoke alarm" checked /> Smoke alarm</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Fire extinguisher" checked /> Fire extinguisher</label>
                    <label><input type="checkbox" name="listing[amenities]" value="First-aid kit" checked /> First-aid kit</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Exterior security cameras" checked /> Exterior security cameras</label>
                    <label><input type="checkbox" name="listing[amenities]" value="Private entrance" checked /> Private entrance</label>
                </div>
            </div>

            <div class="amenities-group" data-climate="cold" hidden>
                <h4>Cold Climate Amenities</h4>
                <div class="amenities-options" data-amenities="cold"></div>
            </div>

            <div class="amenities-group" data-climate="hot" hidden>
                <h4>Hot Climate Amenities</h4>
                <div class="amenities-options" data-amenities="hot"></div>
            </div>

            <div class="amenities-group" data-climate="monsoon" hidden>
                <h4>Monsoon Amenities</h4>
                <div class="amenities-options" data-amenities="monsoon"></div>
            </div>

        </section>


        <!-- ======================================== -->
        <!-- MULTIPLE IMAGE UPLOAD -->
        <!-- ======================================== -->

        <div class="form-group">

            <label>Images</label>

            <div class="image-upload-box">

                <input
                    type="file"
                    id="listingImages"
                    name="listingImages"
                    accept="image/*"
                    multiple
                    hidden
                />

                <button
                    type="button"
                    class="upload-image-btn"
                    id="uploadImagesBtn"
                >
                    Upload Images
                </button>

                <span class="upload-image-info">
                    You can select up to 16 images
                </span>

            </div>


            <div
                id="imagePreview"
                class="image-preview-container"
            ></div>


            <span
                id="imageError"
                class="error-msg"
            ></span>

        </div>


        <!-- ======================================== -->
        <!-- PRICE + COUNTRY -->
        <!-- ======================================== -->

        <div class="form-row">

            <div class="form-group">

                <label>Price</label>

                <input
                    name="listing[price]"
                    type="number"
                    required
                />

                <span class="error-msg"></span>

            </div>


            <div class="form-group">

                <label>Country</label>

                <input
                    name="listing[country]"
                    type="text"
                    required
                />

                <span class="error-msg"></span>

            </div>

        </div>


        <!-- ======================================== -->
        <!-- SUBMIT -->
        <!-- ======================================== -->

        <button
            type="submit"
            class="submit-btn"
        >
            Add
        </button>

    </form>

</div>

<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

    // =====================================================
    // IMAGE UPLOAD
    // =====================================================

    const imageInput =
        document.getElementById("listingImages");

    const uploadImagesBtn =
        document.getElementById("uploadImagesBtn");

    const imagePreview =
        document.getElementById("imagePreview");

    const imageError =
        document.getElementById("imageError");

    const locationInput =
        document.querySelector('input[name="listing[location]"]');

    const climateAmenities = {
        cold: [
            "Room heater",
            "Heating system",
            "Extra blankets",
            "Warm bedding",
            "Hot water",
            "Electric kettle",
            "Indoor drying facility",
            "Thermal / insulated windows",
            "Fireplace / heating stove",
            "Covered parking"
        ],
        hot: [
            "Air conditioning",
            "Ceiling fan",
            "Electric fan",
            "Swimming pool",
            "Refrigerator",
            "Blackout curtains",
            "Outdoor seating",
            "Shaded outdoor area",
            "Drinking water",
            "Mosquito protection"
        ],
        monsoon: [
            "Covered parking",
            "Umbrella",
            "Raincoat / rain gear",
            "Covered entrance",
            "Anti-slip flooring / mats",
            "Clothes drying rack",
            "Indoor clothes-drying area",
            "Waterproof luggage / storage area",
            "Good drainage",
            "Power backup / generator"
        ]
    };

    const climateLocations = {
        cold: [
            "manali", "shimla", "gulmarg", "leh", "ladakh", "auli",
            "mussoorie", "nainital", "srinagar", "darjeeling"
        ],
        hot: [
            "rajasthan", "jaisalmer", "jodhpur", "jaipur", "ahmedabad",
            "nagpur", "delhi", "agra", "hyderabad"
        ],
        monsoon: [
            "mumbai", "pune", "goa", "kerala", "mangalore", "kochi",
            "ratnagiri", "konkan", "cherrapunji"
        ]
    };

    Object.entries(climateAmenities).forEach(
        function ([climate, amenities]) {
            const optionsContainer =
                document.querySelector(
                    '[data-amenities="' + climate + '"]'
                );

            amenities.forEach(
                function (amenity) {
                    const label =
                        document.createElement("label");

                    const checkbox =
                        document.createElement("input");

                    checkbox.type = "checkbox";
                    checkbox.name = "listing[amenities]";
                    checkbox.value = amenity;
                    checkbox.disabled = true;

                    label.appendChild(checkbox);
                    label.appendChild(
                        document.createTextNode(" " + amenity)
                    );
                    optionsContainer.appendChild(label);
                }
            );
        }
    );

    function updateClimateAmenities() {
        const location =
            locationInput.value.trim().toLowerCase();

        const climate =
            Object.entries(climateLocations).find(
                function ([, locations]) {
                    return locations.some(
                        function (keyword) {
                            return location.includes(keyword);
                        }
                    );
                }
            );

        const activeClimate =
            climate ? climate[0] : null;

        document
            .querySelectorAll(".amenities-group[data-climate]")
            .forEach(
                function (section) {
                    const isActive =
                        section.dataset.climate === activeClimate;

                    section.hidden = !isActive;

                    section
                        .querySelectorAll('input[name="listing[amenities]"]')
                        .forEach(
                            function (checkbox) {
                                checkbox.disabled = !isActive;
                            }
                        );
                }
            );
    }

    locationInput.addEventListener(
        "input",
        updateClimateAmenities
    );

    locationInput.addEventListener(
        "change",
        updateClimateAmenities
    );

    updateClimateAmenities();

    const propertyMapElement =
        document.getElementById("listing-location-map");
    const latitudeInput =
        document.getElementById("listing-latitude");
    const longitudeInput =
        document.getElementById("listing-longitude");
    const locationStatus =
        document.getElementById("listing-location-status");
    const searchLocationButton =
        document.getElementById("listing-search-location");
    const addressFields = {
        location: locationInput,
        propertyName:
            document.querySelector('input[name="listing[propertyName]"]'),
        landmark:
            document.querySelector('input[name="listing[landmark]"]'),
        locality:
            document.querySelector('input[name="listing[locality]"]'),
        city:
            document.querySelector('input[name="listing[city]"]'),
        state:
            document.querySelector('input[name="listing[state]"]'),
        pinCode:
            document.querySelector('input[name="listing[pinCode]"]'),
        country:
            document.querySelector('input[name="listing[country]"]')
    };
    const addressLookupFields = [
        addressFields.landmark,
        addressFields.locality,
        addressFields.city,
        addressFields.state,
        addressFields.country,
        addressFields.pinCode
    ];
    const manuallyEditedAddressFields = new Set();

    Object.values(addressFields).forEach(function (input) {
        if (input) {
            input.addEventListener("input", function (event) {
                if (event.isTrusted) {
                    manuallyEditedAddressFields.add(input);
                }
            });
        }
    });

    function showLocationStatus(message) {
        if (locationStatus) {
            locationStatus.textContent = message;
        }
    }

    function suggestAddressField(fieldName, value) {
        const input = addressFields[fieldName];

        if (
            input &&
            value &&
            !manuallyEditedAddressFields.has(input)
        ) {
            input.value = value;

            if (fieldName === "location") {
                input.dispatchEvent(
                    new Event("input", { bubbles: true })
                );
            }
        }
    }

    if (typeof L !== "undefined" && propertyMapElement) {
        const propertyMap =
            L.map(propertyMapElement).setView([20, 0], 2);

        L.tileLayer(
            "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors'
            }
        ).addTo(propertyMap);

        let propertyMarker = null;
        let reverseLookupId = 0;
        let forwardLookupId = 0;
        let forwardLookupController = null;
        let mapInteractionInProgress = false;

        function buildSearchAddress() {
            return [
                addressFields.landmark,
                addressFields.locality,
                addressFields.city,
                addressFields.state,
                addressFields.country,
                addressFields.pinCode
            ]
                .map(input => input.value.trim())
                .filter(Boolean)
                .join(", ");
        }

        function hasCompleteSearchAddress() {
            return Boolean(
                addressFields.city.value.trim() &&
                addressFields.country.value.trim() &&
                (
                    addressFields.landmark.value.trim() ||
                    addressFields.locality.value.trim() ||
                    addressFields.state.value.trim() ||
                    addressFields.pinCode.value.trim()
                )
            );
        }

        function invalidateAddressLookup() {
            forwardLookupId += 1;

            if (forwardLookupController) {
                forwardLookupController.abort();
                forwardLookupController = null;
            }

            searchLocationButton.disabled = false;
            searchLocationButton.textContent = "Search";
            searchLocationButton.setAttribute("aria-busy", "false");
        }

        function updatePropertyCoordinates(latitude, longitude) {
            latitudeInput.value = latitude.toFixed(6);
            longitudeInput.value = longitude.toFixed(6);
        }

        async function suggestAddressFromCoordinates(latitude, longitude) {
            const lookupId = ++reverseLookupId;

            showLocationStatus(
                "Looking up nearby address details. Suggestions may be approximate."
            );

            try {
                const response = await fetch(
                    `/travel/reverse-geocode?latitude=${encodeURIComponent(latitude)}` +
                    `&longitude=${encodeURIComponent(longitude)}`
                );

                if (!response.ok) {
                    throw new Error("Reverse address lookup failed.");
                }

                const result = await response.json();

                if (lookupId !== reverseLookupId) {
                    return;
                }

                if (
                    !result.success ||
                    !result.address ||
                    typeof result.address !== "object" ||
                    Object.keys(result.address).length === 0
                ) {
                    throw new Error(
                        result.message || "No nearby address details were found."
                    );
                }

                const address = result.address;
                const locality =
                    address.neighbourhood ||
                    address.suburb ||
                    address.quarter ||
                    address.residential ||
                    address.city_district ||
                    "";
                const city =
                    address.city ||
                    address.town ||
                    address.village ||
                    address.municipality ||
                    "";
                const landmark =
                    address.amenity ||
                    address.tourism ||
                    address.historic ||
                    address.leisure ||
                    address.shop ||
                    "";

                suggestAddressField("landmark", landmark);
                suggestAddressField("locality", locality);
                suggestAddressField("city", city);
                suggestAddressField("state", address.state || "");
                suggestAddressField("pinCode", address.postcode || "");
                suggestAddressField("country", address.country || "");
                suggestAddressField("location", city || locality);

                showLocationStatus(
                    "Address suggestions loaded. Verify them and adjust the marker to the property's actual entrance; you can edit every address field."
                );
            } catch {
                if (lookupId !== reverseLookupId) {
                    return;
                }

                showLocationStatus(
                    "Address lookup is unavailable. The selected coordinates are saved; enter or correct the address details manually."
                );
            }
        }

        function setPropertyMarker(latitude, longitude, lookupAddress) {
            invalidateAddressLookup();

            if (propertyMarker) {
                propertyMarker.setLatLng([latitude, longitude]);
            } else {
                propertyMarker =
                    L.marker([latitude, longitude], {
                        draggable: true
                    }).addTo(propertyMap);

                propertyMarker.on("dragend", function () {
                    mapInteractionInProgress = false;
                    const position =
                        propertyMarker.getLatLng();
                    updatePropertyCoordinates(
                        position.lat,
                        position.lng
                    );
                    suggestAddressFromCoordinates(
                        position.lat,
                        position.lng
                    );
                });
                propertyMarker.on("dragstart", function () {
                    mapInteractionInProgress = true;
                    invalidateAddressLookup();
                    reverseLookupId += 1;
                });
            }

            updatePropertyCoordinates(latitude, longitude);

            if (lookupAddress) {
                suggestAddressFromCoordinates(latitude, longitude);
            }
        }

        propertyMap.on("click", function (event) {
            setPropertyMarker(
                event.latlng.lat,
                event.latlng.lng,
                true
            );
        });

        async function lookupPropertyAddress() {
            const searchAddress = buildSearchAddress();
            if (!searchAddress || !hasCompleteSearchAddress()) {
                showLocationStatus(
                    "Enter a city and country, plus a nearby address detail, before searching."
                );
                return;
            }

            if (searchLocationButton.disabled || mapInteractionInProgress) {
                return;
            }

            const lookupId = ++forwardLookupId;
            const controller = new AbortController();
            forwardLookupController = controller;
            searchLocationButton.disabled = true;
            searchLocationButton.textContent = "Searching...";
            searchLocationButton.setAttribute("aria-busy", "true");

            showLocationStatus(
                "Searching for this address..."
            );

            try {
                const response = await fetch(
                    `/travel/geocode?location=${encodeURIComponent(searchAddress)}`,
                    {
                        signal: controller.signal
                    }
                );
                const result = await response.json();

                if (lookupId !== forwardLookupId) {
                    return;
                }

                if (
                    searchAddress !== buildSearchAddress() ||
                    mapInteractionInProgress
                ) {
                    return;
                }

                if (
                    response.status === 404 ||
                    (response.ok && !result.success)
                ) {
                    showLocationStatus(
                        "No matching location found. Check the address and try again."
                    );
                    return;
                }

                if (
                    !response.ok ||
                    !result.success ||
                    !Number.isFinite(Number(result.latitude)) ||
                    !Number.isFinite(Number(result.longitude)) ||
                    Number(result.latitude) < -90 ||
                    Number(result.latitude) > 90 ||
                    Number(result.longitude) < -180 ||
                    Number(result.longitude) > 180
                ) {
                    throw new Error(
                        result.message || "Address lookup did not return valid coordinates."
                    );
                }

                const latitude = Number(result.latitude);
                const longitude = Number(result.longitude);

                propertyMap.setView([latitude, longitude], 16);
                setPropertyMarker(latitude, longitude, false);
                showLocationStatus(
                    "Location detected. Adjust the marker to the property's exact entrance if needed."
                );
            } catch (error) {
                if (
                    error.name !== "AbortError" &&
                    lookupId === forwardLookupId
                ) {
                    showLocationStatus(
                        "Location lookup is temporarily unavailable. You can adjust the map marker manually."
                    );
                }
            } finally {
                if (lookupId === forwardLookupId) {
                    forwardLookupController = null;
                    searchLocationButton.disabled = false;
                    searchLocationButton.textContent = "Search";
                    searchLocationButton.setAttribute("aria-busy", "false");
                }
            }
        }

        function handleAddressEdit() {
            const searchWasInProgress =
                forwardLookupController !== null;
            invalidateAddressLookup();
            reverseLookupId += 1;

            if (searchWasInProgress) {
                showLocationStatus(
                    "Address changed. Select Search to look up the updated address."
                );
            }
        }

        addressLookupFields.forEach(function (input) {
            input.addEventListener("input", handleAddressEdit);
            input.addEventListener("change", handleAddressEdit);
        });

        searchLocationButton.addEventListener(
            "click",
            lookupPropertyAddress
        );

        propertyMapElement.addEventListener(
            "pointerdown",
            function () {
                mapInteractionInProgress = true;
                invalidateAddressLookup();
                reverseLookupId += 1;
            }
        );
        window.addEventListener("pointerup", function () {
            mapInteractionInProgress = false;
        });
        window.addEventListener("pointercancel", function () {
            mapInteractionInProgress = false;
        });
    } else {
        searchLocationButton.disabled = true;
        console.error("The property location map could not be loaded.");
        showLocationStatus(
            "The map could not be loaded. Enter the address and coordinates manually."
        );
    }


    // =====================================================
    // OPEN FILE PICKER
    // =====================================================

    uploadImagesBtn.addEventListener(
        "click",
        function () {

            imageInput.click();

        }
    );


    // =====================================================
    // SHOW SELECTED IMAGE PREVIEWS
    // =====================================================

    imageInput.addEventListener(
        "change",
        function () {

            imagePreview.innerHTML = "";

            imageError.innerText = "";

            const files =
                Array.from(
                    imageInput.files
                );


            // Maximum 16 images

            if (files.length > 16) {

                imageError.innerText =
                    "You can select a maximum of 16 images.";

                imageInput.value = "";

                return;

            }


            // Check image files

            for (const file of files) {

                if (!file.type.startsWith("image/")) {

                    imageError.innerText =
                        "Please select only image files.";

                    imageInput.value = "";

                    imagePreview.innerHTML = "";

                    return;

                }

            }


            // Create previews

            files.forEach(
                function (file) {

                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            const previewWrapper =
                                document.createElement("div");

                            previewWrapper.className =
                                "image-preview-item";


                            const image =
                                document.createElement("img");

                            image.src =
                                event.target.result;

                            image.alt =
                                "Selected image";


                            previewWrapper.appendChild(
                                image
                            );


                            imagePreview.appendChild(
                                previewWrapper
                            );

                        };


                    reader.readAsDataURL(file);

                }
            );

        }
    );


    // =====================================================
    // FORM VALIDATION
    // =====================================================

    document
        .getElementById("newForm")
        .addEventListener(
            "submit",
            function (e) {

                let isValid = true;


                // =========================================
                // NORMAL FORM FIELDS
                // =========================================

                document
                    .querySelectorAll(".form-group")
                    .forEach(
                        function (group) {

                            const input =
                                group.querySelector(
                                    "input:not([type='file']), textarea"
                                );

                            const errorMsg =
                                group.querySelector(
                                    ".error-msg"
                                );


                            if (
                                input &&
                                !input.value.trim()
                            ) {

                                errorMsg.innerText =
                                    "This field is required";

                                input.style.border =
                                    "2px solid red";

                                isValid = false;

                            } else if (input) {

                                errorMsg.innerText = "";

                                input.style.border =
                                    "1px solid #ccc";

                            }


                            // Price validation

                            if (
                                input &&
                                input.name ===
                                "listing[price]" &&
                                input.value < 0
                            ) {

                                errorMsg.innerText =
                                    "Price cannot be negative";

                                input.style.border =
                                    "2px solid red";

                                isValid = false;

                            }

                        }
                    );


                // =========================================
                // IMAGE VALIDATION
                // =========================================

                const files =
                    imageInput.files;


                if (
                    !files ||
                    files.length === 0
                ) {

                    imageError.innerText =
                        "Please upload at least one image.";

                    isValid = false;

                }


                if (
                    files.length > 16
                ) {

                    imageError.innerText =
                        "You can select a maximum of 16 images.";

                    isValid = false;

                }

                const latitude =
                    latitudeInput.value.trim();
                const longitude =
                    longitudeInput.value.trim();
                const validCoordinates =
                    latitude !== "" &&
                    longitude !== "" &&
                    Number.isFinite(Number(latitude)) &&
                    Number(latitude) >= -90 &&
                    Number(latitude) <= 90 &&
                    Number.isFinite(Number(longitude)) &&
                    Number(longitude) >= -180 &&
                    Number(longitude) <= 180;

                if (!validCoordinates) {
                    showLocationStatus(
                        "Wait for the location to be detected or select the property on the map before submitting."
                    );
                    isValid = false;
                }


                // =========================================
                // STOP SUBMISSION IF INVALID
                // =========================================

                if (!isValid) {

                    e.preventDefault();

                }

            }
        );

</script>

